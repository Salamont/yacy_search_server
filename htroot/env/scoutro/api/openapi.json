    "/v1/index/lookup": {
      "get": {
        "operationId": "index.lookup",
        "summary": "Look up a URL or host",
        "description": "Whether a URL is indexed, or how many documents a host has. Give exactly one of url or host.",
        "tags": [
          "index"
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "URL to look up (http or https).",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "description": "Host name to count documents for.",
            "schema": {
              "type": "string",
              "maxLength": 253
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lookup result.",
