{
  "openapi": "3.1.0",
  "info": {
    "title": "Scoutro API",
    "version": "1.0.0",
    "description": "Stable, machine-readable action layer of Scoutro (an independent community project based on YaCy). Every action is translated into existing YaCy functions. Mutating and administrative actions require the Scoutro/YaCy administrator account (HTTP Digest). See docs/API.md.",
    "license": {
      "name": "GPL-2.0-or-later",
      "identifier": "GPL-2.0-or-later"
    }
  },
  "servers": [
    {
      "url": "/scoutro/api",
      "description": "Relative to the Scoutro base URL, e.g. http://scoutro:8090/scoutro/api"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check",
        "description": "Public. Confirms that Scoutro and YaCy answer.",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Scoutro is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "YaCy is not available yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-scoutro-mutating": false
      }
    },
    "/v1/system": {
      "get": {
        "operationId": "system.status",
        "summary": "System status",
        "description": "Versions, peer, memory, disk, load and crawler queues.",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "System status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/System"
                }
              }
            }
          },
          "401": {
            "description": "Administrator authentication required (HTTP Digest). The body is the server's HTML error page."
          },
          "502": {
            "description": "YaCy returned an error or an unreadable answer on the loopback interface.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "YaCy is not available yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "digest": []
          }
        ],
        "x-scoutro-mutating": false
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "search",
        "summary": "Search the index",
        "description": "Full-text search (YaCy yacysearch.json).",
        "tags": [
          "search"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query (YaCy query syntax, e.g. site:example.com).",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of results.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Index of the first result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "local index only, or also the peer-to-peer network.",
            "schema": {
              "type": "string",
              "enum": [
                "local",
                "network"
              ],
              "default": "local"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Restrict to a language (two-letter code).",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (validation error; details.field names the parameter).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Administrator authentication required (HTTP Digest). The body is the server's HTML error page."
          },
          "502": {
            "description": "YaCy returned an error or an unreadable answer on the loopback interface.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "YaCy is not available yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "digest": []
          }
        ],
        "x-scoutro-mutating": false
      }
    },
