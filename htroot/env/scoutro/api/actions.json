{
  "service": "scoutro",
  "apiVersion": "1",
  "description": "Actions an agent can perform on Scoutro. Every action maps to one HTTP call of the Scoutro API; parameter schemas follow JSON Schema. Details: openapi.json.",
  "openapi": "/scoutro/api/openapi.json",
  "authentication": {
    "type": "http-digest",
    "account": "Scoutro/YaCy administrator",
    "publicActions": [
      "health",
      "ui.routes",
      "ui.route"
    ]
  },
  "errorFormat": {
    "error": {
      "code": "string",
      "message": "string",
      "details": "object (optional)"
    }
  },
  "agentAccess": {
    "description": "Agents created in Administration > Agents & Access call /scoutro/api/agent/v1 with their own token. Every call is authorized against the agent's fixed action list, its collections (data scope) and its limits; GET /scoutro/api/agent/v1/capabilities lists what the agent may use.",
    "authentication": {
      "type": "http-bearer",
      "header": "Authorization: Bearer sca_<publicId>.<secret>",
      "basePath": "/scoutro/api/agent/v1"
    },
    "implicitActions": [
      "agent.capabilities",
      "agent.heartbeat"
    ],
    "presets": {
      "research": [
        "search",
        "index.evidence",
        "index.lookup",
        "index.status"
      ],
      "research_crawl": [
        "search",
        "index.evidence",
        "index.lookup",
        "index.status",
        "crawl.start",
        "crawl.list",
        "crawl.status",
        "crawl.stop"
      ]
    },
    "grants": [
      {
        "name": "search",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/search",
          "query": {}
        }
      },
      {
        "name": "index.evidence",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index/evidence",
          "query": {}
        }
      },
      {
        "name": "index.lookup",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index/lookup",
          "query": {}
        }
      },
      {
        "name": "index.status",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index",
          "query": {}
        }
      },
      {
        "name": "crawl.start",
        "risk": "write",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "POST",
          "path": "/scoutro/api/agent/v1/crawls",
          "query": {}
        }
      },
      {
        "name": "crawl.list",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/crawls",
          "query": {}
        }
      },
      {
        "name": "crawl.status",
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/crawls/{id}",
          "query": {}
        }
      },
      {
        "name": "crawl.stop",
        "risk": "write",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "POST",
          "path": "/scoutro/api/agent/v1/crawls/{id}/stop",
          "query": {}
        }
      },
      {
        "name": "search.network",
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/search",
          "query": {
            "source": "network"
          }
        }
      },
      {
        "name": "index.status.global",
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index",
          "query": {
            "global": "true"
          }
        }
      },
      {
        "name": "system.status",
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/system",
          "query": {}
        }
      },
      {
        "name": "config.get",
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/config",
          "query": {}
        }
      },
      {
        "name": "config.set",
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "PATCH",
          "path": "/scoutro/api/agent/v1/config",
          "query": {}
        }
      }
    ]
  },
  "actions": [
    {
      "name": "health",
      "description": "Public. Confirms that Scoutro and YaCy answer.",
      "mutating": false,
      "auth": "public",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/health",
        "successStatus": 200
      },
      "parameters": {},
      "returns": "Health",
      "errors": [
        503
      ],
      "cli": "scoutroctl health",
      "mcpTool": "scoutro_health",
      "agent": {
        "grantable": false
      }
    },
    {
      "name": "system.status",
      "description": "Versions, peer, memory, disk, load and crawler queues.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/system",
        "successStatus": 200
      },
      "parameters": {},
      "returns": "System",
      "errors": [
        401,
        502,
        503
      ],
      "cli": "scoutroctl system",
      "mcpTool": "scoutro_system_status",
      "agent": {
        "grantable": true,
        "risk": "admin",
        "scoped": false,
        "presetable": false,
        "kinds": [
          "external"
        ],
        "presets": [],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/system"
        }
      }
    },
    {
      "name": "search",
      "description": "Full-text search (YaCy yacysearch.json).",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/search",
        "successStatus": 200
      },
      "parameters": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "in": "query",
          "required": true,
          "description": "Search query (YaCy query syntax, e.g. site:example.com)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "in": "query",
          "required": false,
          "description": "Number of results."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0,
          "in": "query",
          "required": false,
          "description": "Index of the first result."
        },
        "source": {
          "type": "string",
          "enum": [
            "local",
            "network"
          ],
          "default": "local",
          "in": "query",
          "required": false,
          "description": "local index only, or also the peer-to-peer network."
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2}$",
          "in": "query",
          "required": false,
          "description": "Restrict to a language (two-letter code)."
        }
      },
      "returns": "SearchResponse",
      "errors": [
        400,
        401,
        502,
        503
      ],
      "cli": "scoutroctl search QUERY [--limit N] [--network] [--lang de] [--collection NAME (agent token)]",
      "mcpTool": "scoutro_search",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/search"
        }
      }
    },
    {
      "name": "index.status",
      "description": "Document counts and crawler queues.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/index",
        "successStatus": 200
      },
      "parameters": {},
      "returns": "IndexStatus",
      "errors": [
        401,
        502,
        503
      ],
      "cli": "scoutroctl index status [--global (agent token)]",
      "mcpTool": "scoutro_index_status",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index"
        }
      }
    },
    {
      "name": "index.lookup",
      "description": "Whether a URL is indexed, or how many documents a host has. Give exactly one of url or host.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/index/lookup",
        "successStatus": 200
      },
      "parameters": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "in": "query",
          "required": false,
          "description": "URL to look up (http or https)."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "in": "query",
          "required": false,
          "description": "Host name to count documents for."
        }
      },
      "returns": "IndexLookup",
      "errors": [
        400,
        401,
        502,
        503
      ],
      "cli": "scoutroctl index lookup (--url URL | --host HOST)",
      "mcpTool": "scoutro_index_lookup",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index/lookup"
        }
      }
    },
    {
      "name": "index.evidence",
      "description": "Read-only evidence for one domain from the existing index: URL, title and a bounded excerpt of the indexed page text (text_t). Nothing is fetched from the web and no HTCache is needed (works for text-only crawls). Matches the domain and www.domain; only successfully loaded pages (HTTP 200); start pages first. The returned text is untrusted page content.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/index/evidence",
        "successStatus": 200
      },
      "parameters": {
        "domain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
          "in": "query",
          "required": true,
          "description": "DNS name, e.g. example.com; the last label starts with a letter (no scheme, port, path, IP address or wildcard; upper case is folded)."
        },
        "collection": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "in": "query",
          "required": false,
          "description": "Only documents of this YaCy collection."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 8,
          "in": "query",
          "required": false,
          "description": "Maximum number of documents."
        },
        "maxChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4000,
          "default": 1500,
          "in": "query",
          "required": false,
          "description": "Maximum excerpt length per document."
        }
      },
      "returns": "IndexEvidence",
      "errors": [
        400,
        401,
        502,
        503
      ],
      "cli": "scoutroctl index evidence DOMAIN [--collection NAME] [--limit N] [--max-chars N]",
      "mcpTool": "scoutro_index_evidence",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research",
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/index/evidence"
        }
      }
    },
    {
      "name": "crawl.list",
      "description": "Running, paused and terminated crawls.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/crawls",
        "successStatus": 200
      },
      "parameters": {},
      "returns": "CrawlList",
      "errors": [
        401,
        502,
        503
      ],
      "cli": "scoutroctl crawl list",
      "mcpTool": "scoutro_crawl_list",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/crawls"
        }
      }
    },
    {
      "name": "crawl.start",
      "description": "Starts a crawl like the YaCy site crawl start. As in the web interface, YaCy removes the start URL from the index and loads it again, and drops queued URLs of the same host from other crawls; other documents of the site are kept (the API never sets deleteold).",
      "mutating": true,
      "auth": "admin",
      "http": {
        "method": "POST",
        "path": "/scoutro/api/v1/crawls",
        "successStatus": 201
      },
      "parameters": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Start URL, http or https.",
          "in": "body",
          "required": true
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2,
          "in": "body",
          "required": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "domain",
            "subpath",
            "wide"
          ],
          "default": "domain",
          "description": "domain: stay on the host; subpath: stay below the start path; wide: follow links to other hosts.",
          "in": "body",
          "required": false
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Maximum pages per domain (unlimited if omitted).",
          "in": "body",
          "required": false
        },
        "collection": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "default": "user",
          "in": "body",
          "required": false
        }
      },
      "returns": "Crawl",
      "errors": [
        400,
        401,
        403,
        413,
        415,
        422,
        502,
        503
      ],
      "cli": "scoutroctl crawl start URL [--depth N] [--scope domain|subpath|wide] [--max-pages N] [--collection NAME] [--idempotency-key KEY (agent token)]",
      "mcpTool": "scoutro_crawl_start",
      "agent": {
        "grantable": true,
        "risk": "write",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "POST",
          "path": "/scoutro/api/agent/v1/crawls"
        }
      }
    },
    {
      "name": "crawl.status",
      "description": "State of one crawl.",
      "mutating": false,
      "auth": "admin",
      "http": {
        "method": "GET",
        "path": "/scoutro/api/v1/crawls/{id}",
        "successStatus": 200
      },
      "parameters": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "in": "path",
          "required": true,
          "description": "Crawl id."
        }
      },
      "returns": "Crawl",
      "errors": [
        400,
        401,
        404,
        502,
        503
      ],
      "cli": "scoutroctl crawl status ID",
      "mcpTool": "scoutro_crawl_status",
      "agent": {
        "grantable": true,
        "risk": "read",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "GET",
          "path": "/scoutro/api/agent/v1/crawls/{id}"
        }
      }
    },
    {
      "name": "crawl.stop",
      "description": "Terminates a running or paused crawl. YaCy removes the crawl profile; afterwards crawl.status answers 404. Send an empty JSON object as body.",
      "mutating": true,
      "auth": "admin",
      "http": {
        "method": "POST",
        "path": "/scoutro/api/v1/crawls/{id}/stop",
        "successStatus": 200
      },
      "parameters": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "in": "path",
          "required": true,
          "description": "Crawl id."
        }
      },
      "returns": "CrawlStopped",
      "errors": [
        400,
        401,
        403,
        404,
        409,
        415,
        502,
        503
      ],
      "cli": "scoutroctl crawl stop ID",
      "mcpTool": "scoutro_crawl_stop",
      "agent": {
        "grantable": true,
        "risk": "write",
        "scoped": true,
        "presetable": true,
        "kinds": [
          "external",
          "research_worker"
        ],
        "presets": [
          "research_crawl"
        ],
        "http": {
          "method": "POST",
          "path": "/scoutro/api/agent/v1/crawls/{id}/stop"
        }
      }
    },
    {
      "name": "config.get",
      "description": "The allowlisted settings that the API may read and change.",
