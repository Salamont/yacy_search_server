<!-- top navigation -->
<!-- Scoutro: one header for every page: brand, search, account menu and the
     navigation of docs/SCOUTRO_USERS_ACCESS.md (section 7). Entries follow the
     server-side permissions of the signed-in identity (YaCyDefaultServlet);
     hiding an entry is never the protection. -->
<div class="navbar navbar-inverse navbar-fixed-top scoutro-adminbar" role="navigation">
  <div class="container-fluid scoutro-topbar">
    <a class="navbar-brand" id="navbar-brand" href="#(scoutroRead)#index.html::scoutro-dashboard.html#(/scoutroRead)#">
      <!-- Scoutro: brand, see env/templates/scoutro/ and env/scoutro/brand/ -->
      <span><img id="header-greeting-icon" class="yacylogo scoutro-brand-logo" src="env/scoutro/brand/mascot-64.png" alt=""></span>
      <span class="scoutro-brand-name">&nbsp;#%env/templates/scoutro/productname.template%#</span>
    </a>
    <form id="header-search-form" class="navbar-form scoutro-header-search" method="get" accept-charset="UTF-8" action="yacysearch.html" role="search">
      <label class="sr-only" for="header-search-input">Search</label>
      <input id="header-search-input" name="query" placeholder="Search..." class="form-control" type="text" size="21" maxlength="200" value=""/>
      <input type="hidden" name="resource" value="local" />
      <input type="hidden" name="urlmaskfilter" value=".*" />
      <input type="hidden" name="prefermaskfilter" value="" />
      <input type="hidden" name="nav" value="all" />
      #(authorized)#::
      <input type="hidden" name="auth" value=""/>
      #(/authorized)#
    </form>
    <div class="scoutro-account" id="scoutro-account">
      #(scoutroAccount)#
      <a class="scoutro-account-signin" id="scoutro-signin" href="scoutro-login.html">
        <span class="glyphicon glyphicon-log-in" aria-hidden="true"></span><span class="scoutro-account-label">Sign in</span>
      </a>
      ::
      <details class="scoutro-account-menu" id="scoutro-account-menu">
        <summary aria-label="Account menu">
          <span class="glyphicon glyphicon-user" aria-hidden="true"></span>
          <span class="scoutro-account-label">#[scoutroUser]#</span>
        </summary>
        <div class="scoutro-account-panel">
          <p class="scoutro-account-who"><strong>#[scoutroUser]#</strong>
            <span class="scoutro-account-role">#(scoutroRole)#Guest::Research::Operator::Administrator#(/scoutroRole)#</span></p>
          <a href="scoutro-account.html" id="scoutro-account-link">My account</a>
          <button type="button" class="scoutro-account-signout" id="scoutro-signout">Sign out</button>
        </div>
      </details>
      ::
      <details class="scoutro-account-menu" id="scoutro-account-menu">
        <summary aria-label="Account menu">
          <span class="glyphicon glyphicon-user" aria-hidden="true"></span>
          <span class="scoutro-account-label">#[scoutroUser]#</span>
        </summary>
        <div class="scoutro-account-panel">
          <p class="scoutro-account-who"><strong>#[scoutroUser]#</strong>
            <span class="scoutro-account-role">Administrator (browser sign-in)</span></p>
          <a href="scoutro-account.html" id="scoutro-account-link">My account</a>
          <p class="scoutro-account-hint">The browser keeps this sign-in until it is closed.</p>
        </div>
      </details>
      #(/scoutroAccount)#
    </div>
    <!-- Scoutro: the toggle opens the navigation (#scoutro-adminnav) on small screens, see env/scoutro/scoutro.js -->
    <button type="button" class="navbar-toggle collapsed" id="scoutro-nav-toggle" aria-controls="scoutro-adminnav" aria-expanded="false">
      <span class="sr-only">Toggle navigation</span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>
  </div>
</div>

