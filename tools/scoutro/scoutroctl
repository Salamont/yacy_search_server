#
# A thin client: every command is exactly one call of the Scoutro API
# (/scoutro/api/v1/..., or /scoutro/api/agent/v1/... with an agent token). There is no business logic here; validation and the
# translation to YaCy happen in the API.
#
# Configuration (environment):
#   SCOUTRO_URL            base URL, default http://127.0.0.1:8090
#   SCOUTRO_USER           administrator user, default admin
#   SCOUTRO_PASSWORD       administrator password, or
#   SCOUTRO_PASSWORD_FILE  file containing the password (first line)
#   SCOUTRO_TOKEN          agent token (sca_...) from Administration > Agents &
#                          Access, or
#   SCOUTRO_TOKEN_FILE     file containing the agent token (first line)
# With an agent token, the commands use the agent path /scoutro/api/agent/v1
# with "Authorization: Bearer" and the agent's own rights; the administrator
# password is not used then. Neither the password nor the token is ever
# accepted as a command line argument (process list, shell history).
#
# Output: JSON on stdout. Exit codes: 0 success, 1 API error, 2 usage error,
# 3 Scoutro not reachable.

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

VERSION = "1"


def fail(code, message, exit_code):
    print(json.dumps({"error": {"code": code, "message": message}}, indent=2))
    sys.exit(exit_code)


def password():
    pw = os.environ.get("SCOUTRO_PASSWORD")
    if pw:
        return pw
    path = os.environ.get("SCOUTRO_PASSWORD_FILE")
    if path:
        try:
            with open(path, encoding="utf-8") as f:
                return f.readline().rstrip("\r\n")
        except OSError as e:
            fail("password_file", "cannot read SCOUTRO_PASSWORD_FILE: %s" % e.strerror, 2)
    return None


def agent_token():
    token = os.environ.get("SCOUTRO_TOKEN")
    if token:
        return token.strip()
    path = os.environ.get("SCOUTRO_TOKEN_FILE")
    if path:
        try:
            with open(path, encoding="utf-8") as f:
                return f.readline().strip()
        except OSError as e:
            fail("token_file", "cannot read SCOUTRO_TOKEN_FILE: %s" % e.strerror, 2)
    return None


class Client:
    def __init__(self, base_url, user, pw, timeout, token=None):
        self.base = base_url.rstrip("/") + "/scoutro/api"
        self.timeout = timeout
        self.token = token
        # data actions: admin API v1, or the agent path with an agent token
        self.v1 = "/agent/v1" if token else "/v1"
        handlers = []
        if pw and not token:
            manager = urllib.request.HTTPPasswordMgrWithDefaultRealm()
            manager.add_password(None, base_url, user, pw)
            handlers.append(urllib.request.HTTPDigestAuthHandler(manager))
        self.opener = urllib.request.build_opener(*handlers)

    def call(self, method, path, query=None, body=None, extra_headers=None, raw=False):
        url = self.base + path
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        data = None
        headers = {"Accept": "application/json", "User-Agent": "scoutroctl/" + VERSION}
        if self.token and path.startswith("/agent/"):
            headers["Authorization"] = "Bearer " + self.token
        if extra_headers:
            headers.update(extra_headers)
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with self.opener.open(request, timeout=self.timeout) as response:
                if raw:
                    for chunk in iter(lambda: response.read(65536), b""):
                        sys.stdout.buffer.write(chunk)
                    sys.stdout.flush()
                    return None
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            raw = e.read().decode("utf-8", "replace")
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = None
            if e.code == 401 and not (isinstance(payload, dict) and "error" in payload):
                fail("unauthorized", "authentication required: set SCOUTRO_PASSWORD or SCOUTRO_PASSWORD_FILE "
                     "(administrator account), or SCOUTRO_TOKEN / SCOUTRO_TOKEN_FILE (agent token)", 1)
            if isinstance(payload, dict) and "error" in payload:
                print(json.dumps(payload, indent=2, ensure_ascii=False))
                sys.exit(1)
            fail("http_%d" % e.code, "Scoutro answered HTTP %d" % e.code, 1)
        except urllib.error.URLError as e:
            fail("unreachable", "Scoutro is not reachable at %s: %s" % (self.base, e.reason), 3)


def build_parser():
    p = argparse.ArgumentParser(prog="scoutroctl", description="Command line client for the Scoutro API.")
    p.add_argument("--base-url", dest="base_url", default=os.environ.get("SCOUTRO_URL", "http://127.0.0.1:8090"),
                   help="Scoutro base URL (default: $SCOUTRO_URL or http://127.0.0.1:8090)")
    p.add_argument("--user", default=os.environ.get("SCOUTRO_USER", "admin"), help="administrator user (default: admin)")
    p.add_argument("--timeout", type=float, default=90, help="request timeout in seconds")
    p.add_argument("--compact", action="store_true", help="print compact JSON")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("health", help="health check (public)")
    sub.add_parser("system", help="system status")
    sub.add_parser("capabilities", help="actions, collections and limits of the agent token (needs SCOUTRO_TOKEN)")
    sub.add_parser("actions", help="print the action catalog (actions.json)")
    sub.add_parser("openapi", help="print the OpenAPI description")
    sub.add_parser("discovery",
                   help="profile discovery (status|start|pause|resume|classify|search|export|migrate-state|selftest); delegates to scoutro-discovery")

    cols = sub.add_parser("collections", help="the collection catalog (admin) or the granted collections (agent); create one (admin)")
    cols_sub = cols.add_subparsers(dest="collections_command")
    create = cols_sub.add_parser("create", help="administrator: create an empty collection that crawls and filters can choose")
    create.add_argument("name", help="display name, e.g. 'Mein neues Portal'")
    create.add_argument("--id", help="collection id (2-64 lower-case letters, digits, single hyphens); default: derived from the name")
    create.add_argument("--description", help="optional description")
    reassign = cols_sub.add_parser("reassign", help="administrator: move one domain's pages between collections "
                                   "(preview without --confirm; nothing is crawled or deleted)")
    reassign.add_argument("domain", help="one registrable domain, e.g. example.com (its subdomains included)")
    reassign.add_argument("--add", action="append", default=[], help="collection to add, repeatable")
    reassign.add_argument("--remove", action="append", default=[], help="collection to remove, repeatable")
    reassign.add_argument("--confirm", help="the token of the preview to apply")
    host = sub.add_parser("host", help="normalize a host or URL and check the index").add_subparsers(dest="host_command", required=True)
    resolve = host.add_parser("resolve")
    resolve.add_argument("input")
    resolve.add_argument("--collection")
    sub.add_parser("automation", help="read-only Discovery Automation status").add_subparsers(dest="automation_command", required=True).add_parser("status")
    s = sub.add_parser("search", help="search the index")
    s.add_argument("query")
    s.add_argument("--limit", type=int)
    s.add_argument("--offset", type=int)
    s.add_argument("--network", action="store_true", help="also search the peer-to-peer network")
    s.add_argument("--lang", help="two-letter language code")
    s.add_argument("--collection", help="agent token only: one of the agent's collections")

    ask = sub.add_parser("ask", help="structured DE/EN Scoutro system question; no web fallback")
    ask.add_argument("question")
    ask.add_argument("--collection")
    idx = sub.add_parser("index", help="index status, lookup and evidence").add_subparsers(dest="index_command", required=True)
    browse = idx.add_parser("browse", help="read-only literal host/URL search")
    browse.add_argument("query", nargs="?", default="")
    browse.add_argument("--collection")
    browse.add_argument("--limit", type=int)
    browse.add_argument("--offset", type=int)
    ist = idx.add_parser("status")
    ist.add_argument("--global", dest="global_status", action="store_true",
                     help="agent token only: global index status (needs the grant index.status.global)")
    metric = idx.add_parser("metrics", help="scoped document/page/host counts")
    metric.add_argument("--collection")
    lookup = idx.add_parser("lookup")
    g = lookup.add_mutually_exclusive_group(required=True)
    g.add_argument("--url")
    g.add_argument("--host")
    lookup.add_argument("--collection", help="agent token only: one of the agent's collections")
    ev = idx.add_parser("evidence", help="indexed text of a domain (URL, title, excerpt from text_t)")
    ev.add_argument("domain")
    ev.add_argument("--collection")
    ev.add_argument("--limit", type=int)
    ev.add_argument("--max-chars", type=int)

    crawl = sub.add_parser("crawl", help="crawls").add_subparsers(dest="crawl_command", required=True)
    crawl.add_parser("list")
    start = crawl.add_parser("start")
    start.add_argument("url")
    start.add_argument("--depth", type=int)
    start.add_argument("--scope", choices=["domain", "subpath", "wide"])
    start.add_argument("--max-pages", type=int, dest="max_pages")
    start.add_argument("--collection", required=True, help="explicit target collection (no default)")
    start.add_argument("--idempotency-key", dest="idempotency_key",
                       help="a repeated start with the same key returns the existing crawl")
    for name in ("status", "stop"):
        c = crawl.add_parser(name)
        c.add_argument("id")

    cfg = sub.add_parser("config", help="allowlisted settings").add_subparsers(dest="config_command", required=True)
    cfg.add_parser("get")
    cs = cfg.add_parser("set")
    cs.add_argument("key")
    cs.add_argument("value", help="integers are sent as numbers")

    kg = sub.add_parser("kg", help="knowledge graph: reads (kg.read), export and changes (kg.export), status/control/download (administrator)") \
        .add_subparsers(dest="kg_command", required=True)
    ents = kg.add_parser("entities")
    ents.add_argument("--q")
    ents.add_argument("--type", choices=["organization", "facility", "site", "place", "service", "job"])
    ents.add_argument("--host")
    ents.add_argument("--quality", choices=["supported", "uncertain", "stale"])
    ents.add_argument("--industry", help="NACE Rev. 2.1 / WZ 2025 code (43, 43.2, 43.22)")
    ents.add_argument("--category", help="service category or group (care/tagespflege, care.stationaer)")
    ents.add_argument("--audience", help="customer type, segment or company size (b2b, sme)")
    for name in ("entity", "statements", "statement", "evidence", "host", "source"):
        k = kg.add_parser(name)
        k.add_argument("id", help={"host": "host name", "source": "Solr document id"}.get(name, "entity or statement ID"))
        if name == "statements":
            k.add_argument("--direction", choices=["out", "in"])
            k.add_argument("--predicate")
            k.add_argument("--include-stale", dest="include_stale", action="store_true")
    for k in [ents] + [kg.choices[n] for n in ("entity", "statements", "statement", "evidence", "host", "source")]:
        k.add_argument("--collection", help="only evidence of this collection (agent token: one of the agent's collections)")
        if k is not kg.choices["entity"] and k is not kg.choices["statement"]:
            k.add_argument("--limit", type=int)
            k.add_argument("--offset", type=int)
    bv = kg.add_parser("business", help="the object view of an entity: industry, services, prices, contacts, relations, jobs, audiences, suggestions")
    bv.add_argument("id", help="entity ID")
    bv.add_argument("--include-hidden-jobs", dest="hidden_jobs", action="store_true")
    nb = kg.add_parser("neighborhood", help="the network around an entity (nodes and typed edges)")
    nb.add_argument("id", help="entity ID")
    nb.add_argument("--depth", type=int, choices=[1, 2])
    nb.add_argument("--types", help="comma-separated edge types")
    nb.add_argument("--weak", action="store_true", help="include linked_to (weak signals)")
    nb.add_argument("--no-derived", dest="no_derived", action="store_true", help="without same_operator")
    nb.add_argument("--suggested", action="store_true", help="include suggested matches")
    nb.add_argument("--no-values", dest="no_values", action="store_true", help="without industry and audience value nodes")
    nb.add_argument("--include-stale", dest="include_stale", action="store_true")
    nb.add_argument("--prices", action="store_true", help="the published prices of the services in the centre and at depth 1")
    cmp_ = kg.add_parser("compare", help="one service category across providers, prices as published")
    cmp_.add_argument("category")
    der = kg.add_parser("derived", help="derived rows: linked_to, same_operator, suggested_customer, suggested_partner (never facts)")
    der.add_argument("--kind", choices=["linked_to", "same_operator", "suggested_customer", "suggested_partner"])
    der.add_argument("--entity")
    fc = kg.add_parser("facets", help="industries, categories and audiences the visible graph holds")
    sg = kg.add_parser("services", help="services of the same name across providers, read-only groups (never merged)")
    sg.add_argument("--q", help="name words")
    sg.add_argument("--category")
    sp = kg.add_parser("service-providers", help="the services of one name, each with its own provider, prices and sources")
    sp.add_argument("name", help="the service name (e.g. SAP)")
    sp.add_argument("--category")
    sn = kg.add_parser("service-network", help="all providers of one service name around the name; each line the provider's own service")
    sn.add_argument("name", help="the service name (e.g. SAP)")
    sn.add_argument("--category")
    sn.add_argument("--include-stale", action="store_true", help="also outdated offers")
    for k in (bv, nb, cmp_, der, fc, sg, sp, sn):
        k.add_argument("--collection", help="only evidence of this collection (agent token: one of the agent's collections)")
        if k in (nb, cmp_, der, sg, sp, sn):
            k.add_argument("--limit", type=int)
        if k in (nb, der, sg, sp, sn):
            k.add_argument("--offset", type=int)
    exp = kg.add_parser("export", help="one export page, or with --all every record as one JSON line")
    exp.add_argument("--cursor")
    exp.add_argument("--limit", type=int)
    exp.add_argument("--evidence", action="store_true")
    exp.add_argument("--collection")
    exp.add_argument("--all", action="store_true")
    ch = kg.add_parser("changes")
    ch.add_argument("--cursor")
    ch.add_argument("--limit", type=int)
    ch.add_argument("--expand", action="store_true")
    ch.add_argument("--collection")
    dl = kg.add_parser("download", help="administrator: the whole export as NDJSON or JSON to stdout")
    dl.add_argument("--format", choices=["ndjson", "json"])
    dl.add_argument("--evidence", action="store_true")
    dl.add_argument("--collection")
    kg.add_parser("status", help="administrator")
    kg.add_parser("collections", help="administrator: the knowledge graph settings of each collection (on/off, vocabulary)")
    kc = kg.add_parser("collection", help="administrator: switch a collection on or off for the graph, set its vocabulary (takes effect at once)")
    kc.add_argument("name", help="a collection of 'kg collections'")
    onoff = kc.add_mutually_exclusive_group()
    onoff.add_argument("--on", action="store_true", help="follow it; the pages it already has in the index are read")
    onoff.add_argument("--off", action="store_true", help="switch it off; its graph data are kept")
    voc = kc.add_mutually_exclusive_group()
    voc.add_argument("--vocabulary", help="a vocabulary of 'kg collections'")
    voc.add_argument("--no-vocabulary", action="store_true", help="no vocabulary (generic facts only)")
    voc.add_argument("--default-vocabulary", action="store_true", help="the default of the vocabulary files")
    llm = kc.add_mutually_exclusive_group()
    llm.add_argument("--llm", action="store_true", help="also the LLM enrichment (the model of the LLM selection, usage knowledge)")
    llm.add_argument("--no-llm", action="store_true", help="no LLM enrichment for this collection")
    ctl = kg.add_parser("control", help="administrator")
    ctl.add_argument("action", choices=["pause", "resume", "reconcile", "confirm_reconcile", "llm_retry", "backup",
                                        "rebuild", "rebuild_cancel", "rebuild_confirm", "derive"])
    kg.add_parser("backup", help="administrator: start a backup into DATA/SCOUTRO/knowledge/backup")
    kg.add_parser("backups", help="administrator: list the backups")
    bd = kg.add_parser("backup-download", help="administrator: write a backup file to stdout")
    bd.add_argument("file")
    rs = kg.add_parser("restore", help="administrator: replace the graph with a backup (the current graph is kept as a backup)")
    rs.add_argument("file")
    bdel = kg.add_parser("backup-delete", help="administrator: delete one backup (by its name of 'kg backups') with its metadata")
    bdel.add_argument("file")
    kg.add_parser("rebuild", help="administrator: re-resolve every identity in a shadow graph built from Solr (progress in kg status)")
    kg.add_parser("rebuild-cancel", help="administrator: cancel a rebuild before its swap; the graph stays as it is")
    kg.add_parser("rebuild-confirm", help="administrator: swap in a rebuild that the mass-deletion brake stopped")

    ui = sub.add_parser("ui", help="web interface routes (public)").add_subparsers(dest="ui_command", required=True)
    ui.add_parser("routes")
    r = ui.add_parser("route")
    r.add_argument("name")
    return p


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    # "discovery" is the one Scoutro command that orchestrates several API
    # calls (search + crawl) plus a filter and a small persistent state; it
    # lives in the sibling tool scoutro-discovery. Delegate to it.
    if argv and argv[0] == "discovery":
        script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scoutro-discovery")
        os.execv(sys.executable, [sys.executable, script] + argv[1:])
    args = build_parser().parse_args(argv)
    token = agent_token()
    client = Client(args.base_url, args.user, password(), args.timeout, token)
    v1 = client.v1
    c = args.command
    if c == "health":
        result = client.call("GET", "/v1/health")
    elif c == "capabilities":
        if not token:
            fail("no_token", "capabilities needs an agent token in SCOUTRO_TOKEN or SCOUTRO_TOKEN_FILE", 2)
        result = client.call("GET", "/agent/v1/capabilities")
    elif c == "ask":
        result = client.call("GET", v1 + "/system/questions", {"q":args.question,"collection":args.collection})
    elif c == "system":
        result = client.call("GET", v1 + "/system")
    elif c == "actions":
        result = client.call("GET", "/actions.json")
    elif c == "openapi":
        result = client.call("GET", "/openapi.json")
    elif c == "collections":
        if getattr(args, "collections_command", None) == "create":
            body = {"name": args.name}
            if args.id:
                body["id"] = args.id
            if args.description:
                body["description"] = args.description
            result = client.call("POST", v1 + "/collections", body=body)
        elif getattr(args, "collections_command", None) == "reassign":
            body = {"domain": args.domain, "add": args.add, "remove": args.remove}
            if args.confirm:
                body["confirm"] = args.confirm
            result = client.call("POST", v1 + "/collections/reassign", body=body)
        else:
            result = client.call("GET", v1 + "/collections")
    elif c == "host":
        result = client.call("GET", v1 + "/hosts/resolve", {"input": args.input, "collection": args.collection})
    elif c == "automation":
        result = client.call("GET", v1 + "/discovery/status")
    elif c == "search":
        result = client.call("GET", v1 + "/search", {"q": args.query, "limit": args.limit, "offset": args.offset,
                                                     "source": "network" if args.network else None, "lang": args.lang,
                                                     "collection": args.collection})
    elif c == "index":
        if args.index_command == "browse":
            result = client.call("GET", v1 + "/index/browse", {"q": args.query, "collection": args.collection, "limit": args.limit, "offset": args.offset})
        elif args.index_command == "status":
            result = client.call("GET", v1 + "/index", {"global": "true" if args.global_status else None})
        elif args.index_command == "metrics":
            result = client.call("GET", v1 + "/index/metrics", {"collection":args.collection})
        elif args.index_command == "evidence":
            result = client.call("GET", v1 + "/index/evidence", {"domain": args.domain, "collection": args.collection,
                                                               "limit": args.limit, "maxChars": args.max_chars})
        else:
            result = client.call("GET", v1 + "/index/lookup", {"url": args.url, "host": args.host,
                                                               "collection": args.collection})
    elif c == "crawl":
        if args.crawl_command == "list":
            result = client.call("GET", v1 + "/crawls")
        elif args.crawl_command == "start":
            body = {"url": args.url}
            for key, value in (("depth", args.depth), ("scope", args.scope), ("maxPages", args.max_pages),
                               ("collection", args.collection)):
                if value is not None:
                    body[key] = value
            result = client.call("POST", v1 + "/crawls", body=body,
                                 extra_headers={"Idempotency-Key": args.idempotency_key} if args.idempotency_key else None)
        elif args.crawl_command == "status":
            result = client.call("GET", v1 + "/crawls/" + urllib.parse.quote(args.id, safe=""))
        else:
            result = client.call("POST", v1 + "/crawls/" + urllib.parse.quote(args.id, safe="") + "/stop", body={})
    elif c == "kg":
        k = args.kg_command
        q = lambda path: urllib.parse.quote(path, safe="")
        if k in ("status", "control", "download", "backup", "backups", "backup-download", "restore",
                 "rebuild", "rebuild-cancel", "rebuild-confirm", "collections", "collection", "backup-delete") and token:
            fail("admin_only", "kg %s is an administrator route; it is not available with an agent token" % k, 2)
        if k == "status":
            result = client.call("GET", "/v1/kg/status")
        elif k == "collections":
            result = client.call("GET", "/v1/kg/collections")
        elif k == "collection":
            body = {}
            if args.on or args.off:
                body["active"] = bool(args.on)
            if args.vocabulary is not None:
                body["vocabulary"] = args.vocabulary
            elif args.no_vocabulary:
                body["vocabulary"] = ""
            elif args.default_vocabulary:
                body["vocabulary"] = None
            if args.llm or args.no_llm:
                body["llm"] = bool(args.llm)
            if not body:
                fail("invalid_request", "give --on or --off, a vocabulary option and/or --llm or --no-llm", 2)
            result = client.call("PATCH", "/v1/kg/collections/" + q(args.name), body=body)
        elif k == "control":
            result = client.call("POST", "/v1/kg/control", body={"action": args.action})
        elif k == "backup":
            result = client.call("POST", "/v1/kg/control", body={"action": "backup"})
        elif k == "backup-delete":
            result = client.call("POST", "/v1/kg/control", body={"action": "delete_backup", "backup": args.file})
        elif k == "backups":
            result = client.call("GET", "/v1/kg/backups")
        elif k == "backup-download":
            client.call("GET", "/v1/kg/backups/" + q(args.file), raw=True)
            return 0
        elif k == "restore":
            result = client.call("POST", "/v1/kg/control", body={"action": "restore", "backup": args.file})
        elif k in ("rebuild", "rebuild-cancel", "rebuild-confirm"):
            result = client.call("POST", "/v1/kg/control", body={"action": k.replace("-", "_")})
        elif k == "download":
            client.call("GET", "/v1/kg/export/download", {"format": args.format, "include": "evidence" if args.evidence else None,
                                                         "collection": args.collection}, raw=True)
            return 0
        elif k == "export":
            query = {"cursor": args.cursor, "limit": args.limit, "include": "evidence" if args.evidence else None,
                     "collection": args.collection}
            if not args.all:
                result = client.call("GET", v1 + "/kg/export", query)
            else:
                while True:
                    page = client.call("GET", v1 + "/kg/export", query)
                    for record in page.get("items", []):
                        print(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
                    if page.get("complete"):
                        print(json.dumps({"record": "end", "next_changes": page.get("next_changes")}, separators=(",", ":")))
                        return 0
                    query["cursor"] = page.get("next")
        elif k == "changes":
            result = client.call("GET", v1 + "/kg/changes", {"cursor": args.cursor, "limit": args.limit,
                                                          "expand": "true" if args.expand else None, "collection": args.collection})
        elif k == "business":
            result = client.call("GET", v1 + "/kg/entities/%s/business" % q(args.id),
                                 {"include": "hidden_jobs" if args.hidden_jobs else None, "collection": args.collection})
        elif k == "neighborhood":
            result = client.call("GET", v1 + "/kg/entities/%s/neighborhood" % q(args.id), {
                "depth": args.depth, "types": args.types, "weak": "true" if args.weak else None,
                "derived": "false" if args.no_derived else None, "suggested": "true" if args.suggested else None,
                "values": "false" if args.no_values else None, "include": "stale" if args.include_stale else None,
                "prices": "true" if args.prices else None, "limit": args.limit, "offset": args.offset, "collection": args.collection})
        elif k == "compare":
            result = client.call("GET", v1 + "/kg/compare", {"category": args.category, "limit": args.limit, "collection": args.collection})
        elif k == "derived":
            result = client.call("GET", v1 + "/kg/derived", {"kind": args.kind, "entity": args.entity, "limit": args.limit,
                                                          "offset": args.offset, "collection": args.collection})
        elif k == "facets":
            result = client.call("GET", v1 + "/kg/facets", {"collection": args.collection})
        elif k == "services":
            result = client.call("GET", v1 + "/kg/services", {"q": args.q, "category": args.category, "limit": args.limit,
                                                           "offset": args.offset, "collection": args.collection})
        elif k == "service-providers":
            result = client.call("GET", v1 + "/kg/services/providers", {"name": args.name, "category": args.category, "limit": args.limit,
                                                                     "offset": args.offset, "collection": args.collection})
        elif k == "service-network":
            result = client.call("GET", v1 + "/kg/services/network", {"name": args.name, "category": args.category, "limit": args.limit,
                                                                   "offset": args.offset, "include": "stale" if args.include_stale else None,
                                                                   "collection": args.collection})
        else:
            paths = {"entities": "/kg/entities", "entity": "/kg/entities/%s", "statements": "/kg/entities/%s/statements",
                     "statement": "/kg/statements/%s", "evidence": "/kg/statements/%s/evidence",
                     "host": "/kg/hosts/%s/entities", "source": "/kg/sources/%s"}
            path = paths[k] % q(args.id) if "%s" in paths[k] else paths[k]
            query = {"collection": args.collection}
            for name in ("q", "type", "host", "quality", "industry", "category", "audience", "direction", "predicate", "limit", "offset"):
                if name != "host" or k == "entities":
                    query[name] = getattr(args, name, None)
            if getattr(args, "include_stale", False):
                query["include"] = "stale"
            result = client.call("GET", v1 + path, query)
    elif c == "config":
        if args.config_command == "get":
            result = client.call("GET", v1 + "/config")
        else:
            value = int(args.value) if args.value.lstrip("-").isdigit() else args.value
            result = client.call("PATCH", v1 + "/config", body={args.key: value})
    else:
        if args.ui_command == "routes":
            result = client.call("GET", "/v1/ui/routes")
        else:
            result = client.call("GET", "/v1/ui/routes/" + urllib.parse.quote(args.name, safe=""))
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")) if args.compact
          else json.dumps(result, indent=2, ensure_ascii=False))
    return 0


