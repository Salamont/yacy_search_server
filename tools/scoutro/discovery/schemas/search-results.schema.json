{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Salamont/yacy_search_server/tools/scoutro/discovery/schemas/search-results.schema.json",
  "title": "Scoutro discovery: structured profile search",
  "description": "Output of 'scoutro-discovery search' (schema version 1): local search in the profile collection(s), grouped by domain and joined with the stored classification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "collections", "query", "verdict_filter", "total", "results"],
  "properties": {
    "schema_version": {"const": "1"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "collections": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}},
    "query": {"type": "string", "minLength": 1, "maxLength": 200},
    "verdict_filter": {"type": "array", "items": {"enum": ["PASS", "FAIL", "UNSURE", "UNCLASSIFIED"]}},
    "total": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain", "verdict", "classification", "hits"],
        "properties": {
          "domain": {"type": "string", "minLength": 1, "maxLength": 253},
          "verdict": {"enum": ["PASS", "FAIL", "UNSURE", "UNCLASSIFIED"]},
          "classification": {"oneOf": [{"type": "null"}, {"$ref": "classification.schema.json"}]},
          "hits": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["url", "title", "snippet"],
              "properties": {
                "url": {"type": "string", "maxLength": 2048},
                "title": {"type": "string", "maxLength": 300},
                "snippet": {"type": "string", "maxLength": 400}
              }
            }
          }
        }
      }
    }
  }
}
