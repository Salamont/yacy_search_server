{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Salamont/yacy_search_server/tools/scoutro/discovery/schemas/classification-model-output.schema.json",
  "title": "Scoutro classifier: LLM answer",
  "description": "The only answer format accepted from the language model. Anything else (extra fields, free text, missing fields) is rejected and the result becomes UNSURE. profile, domain, country source and timestamps are set by scoutro-discovery, never by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confidence", "entity_type", "country", "location", "reasons", "evidence_urls"],
  "properties": {
    "verdict": {"enum": ["PASS", "FAIL", "UNSURE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "entity_type": {"enum": ["company", "care_facility", "coach", "it_provider", "construction_provider",
                             "association", "authority", "university_research", "news_media",
                             "directory_portal", "private_person", "other", "unknown"]},
    "country": {"type": "string", "pattern": "^([A-Z]{2}|unknown)$"},
    "location": {"type": "string", "maxLength": 200},
    "reasons": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "text"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "text": {"type": "string", "maxLength": 300}
        }
      }
    },
    "evidence_urls": {
      "type": "array", "maxItems": 5,
      "items": {"type": "string", "maxLength": 2048, "pattern": "^https?://"}
    }
  }
}
