    "youtube.", "youtu.be", "vimeo.", "twitch.",
    "facebook.", "instagram.", "linkedin.", "xing.", "twitter.", "x.com", "reddit.",
    "pinterest.", "tiktok.", "snapchat.", "tumblr.", "vk.com",
    "google.", "bing.", "duckduckgo.", "yahoo.", "yandex.", "baidu.", "qwant.",
    "ecosia.", "startpage.", "brave.com", "mojeek.", "searx.",
    "archive.org", "scribd.", "slideshare.", "docplayer.", "yumpu.", "studylib.",
    "researchgate.", "springer.", "sciencedirect.", "jstor.", "academia.edu",
    "amazon.", "ebay.", "aliexpress.", "etsy.", "idealo.", "check24.",
    "spiegel.", "bild.", "faz.", "zeit.", "sueddeutsche.", "ntv.", "t-online.",
    "heise.", "golem.", "chip.", "computerbild.", "focus.", "welt.", "stern.",
    "handelsblatt.", "manager-magazin.", "wiwo.", "t3n.", "netzwelt.",
