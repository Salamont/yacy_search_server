def load_profiles(path):
    profiles = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            name, rest = line.split("=", 1)
            terms = [t.strip() for t in rest.split(";") if t.strip()]
            if name.strip() and terms:
                profiles[name.strip()] = terms
    return profiles


def load_rules(cfg_dir):
    """profiles.json (collections + classification criteria); optional for discovery."""
    path = os.path.join(cfg_dir, "profiles.json")
    if not os.path.isfile(path):
        return {"criteria_version": "unversioned", "profiles": {}}
    return sc.load_profile_rules(path)


def collection_for(rules, profile):
    return rules["profiles"][profile]["collection"]


def load_regions(path):
    regions = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                regions.append(line)
    return regions


class StateError(Exception):
    pass


# ---------------------------------------------------------------------------
# state model
# ---------------------------------------------------------------------------
#
# state_version 2 (multi-profile). One entry per registrable domain:
#
#   domains.<domain> = {
#     "domain": ..., "first_seen": ...,              domain-wide
#     "profiles": {                                  one crawl state per profile
#       "<profile>": {"collection", "status", "last_crawl", "attempts", "last_error",
#                     "error_class", "last_http_status", "next_attempt", "crawl_id",
#                     "candidate_url", "region", "first_seen"}},
#     "classifications": {"<profile>": <record>}     unchanged (one active record per profile)
#   }
#
# state_version 1 (scoutro-discovery <= 3) kept all crawl fields flat on the
# domain entry next to "profile", so a crawl for a second profile overwrote the
# first one. normalize_entry() moves those fields to profiles[<profile>]; no
# field is dropped. Entries whose profile cannot be determined keep their flat
# fields under "unassigned".

STATE_VERSION = 2
DOMAIN_FIELDS = ("domain", "first_seen", "classifications", "profiles", "unassigned")


def _profile_from_collection(collection):
    c = str(collection or "")
    if c.endswith("-web") and len(c) > 4:
        return c[:-4]
    if c.startswith("prospect-") and len(c) > 9:
        return c[9:]
    return ""


def normalize_entry(name, entry):
    """Return (entry in the version 2 layout, migrated?). Pure: the argument is not changed.

    Flat (version 1) crawl fields go to profiles[<profile>]; "profile" names the
    profile (else the collection "<p>-web"/"prospect-<p>", else the only
    classification profile). Flat fields of an entry that also has "profiles"
    (written by an older tool after the migration) are newer and overwrite the
    fields of that profile. Nothing is dropped.
    """
    if not isinstance(entry, dict):
        return entry, False
    flat = {k: v for k, v in entry.items() if k not in DOMAIN_FIELDS}
    if not flat and isinstance(entry.get("profiles"), dict):
        return entry, False
    out = {k: v for k, v in entry.items() if k in DOMAIN_FIELDS}
    out["domain"] = entry.get("domain") or name
    profiles = {p: dict(v) for p, v in (entry.get("profiles") or {}).items()}
    profile = flat.pop("profile", "") or _profile_from_collection(flat.get("collection"))
    if not profile and len(entry.get("classifications") or {}) == 1:
        profile = next(iter(entry["classifications"]))
    if profile:
        pe = profiles.setdefault(profile, {})
        pe.update(flat)
        if "first_seen" in entry:
            pe.setdefault("first_seen", entry["first_seen"])
    elif flat:
        unassigned = dict(out.get("unassigned") or {})
        unassigned.update(flat)
        out["unassigned"] = unassigned
    out["profiles"] = profiles
    return out, True


def migration_losses(old_domains, new_domains):
    """Every value of the old entries must be found in the new ones; returns the problems (empty = lossless)."""
    problems = []
    for name, old in old_domains.items():
        new = new_domains.get(name)
        if not isinstance(new, dict):
            problems.append("%s: domain missing" % name)
            continue
        if not isinstance(old, dict):
            continue
        if old.get("classifications", {}) != new.get("classifications", {}):
            problems.append("%s: classifications changed" % name)
        if "first_seen" in old and old["first_seen"] != new.get("first_seen"):
            problems.append("%s: first_seen changed" % name)
        if old.get("profile"):
            if old["profile"] not in new.get("profiles", {}):
                problems.append("%s: profile %s missing" % (name, old["profile"]))
                continue
        for k, v in old.items():
            if k in DOMAIN_FIELDS or k == "profile":
                continue
            found = [pe for pe in new.get("profiles", {}).values() if pe.get(k) == v]
            if not found and (new.get("unassigned") or {}).get(k) != v:
                problems.append("%s: field %s lost" % (name, k))
        for p, pe in (old.get("profiles") or {}).items():
            target = new.get("profiles", {}).get(p, {})
            for k, v in pe.items():
                if k not in target:
                    problems.append("%s: %s.%s lost" % (name, p, k))
    return problems


def normalize_state(data):
    """Normalize all domain entries in place; returns the number of migrated entries."""
    migrated = 0
    domains = data.get("domains")
    if not isinstance(domains, dict):
        domains = data["domains"] = {}
    for name in list(domains):
        entry, changed = normalize_entry(name, domains[name])
        if changed:
            domains[name] = entry
            migrated += 1
    data["state_version"] = STATE_VERSION
    return migrated


class State:
    """Persistent discovery state (state.json).

    Integrity rules:
      - writes are atomic: temp file + fsync + os.replace + directory fsync, so
        an aborted container leaves either the old or the new file, never half;
      - an unreadable state.json is never silently replaced by an empty state;
      - every write happens under an exclusive file lock (state.lock);
      - the "paused" flag is owned by pause/resume: other commands keep the
        value that is on disk, so a pause during a running start is not lost;
      - start and classify take a run lock (run.lock) so that two runs never
        overwrite each other's domain updates;
      - a state of an older layout is migrated in memory when it is read; the
        file is rewritten only by the next regular write, and before that first
        write the original file is kept once as state.v1.json (atomically).
    """

    BACKUP = "state.v1.json"

    def __init__(self, directory):
        self.dir = directory
        self.path = os.path.join(directory, "state.json")
        self.data, self.disk_version, self.migrated = self._read()
        self._run_lock = None

    def _load_raw(self):
        data = {"paused": False, "profiles": {}, "domains": {}}
        if os.path.isfile(self.path):
            try:
                with open(self.path, encoding="utf-8") as f:
                    loaded = json.load(f)
                if not isinstance(loaded, dict):
                    raise ValueError("not a JSON object")
                data.update(loaded)
            except (ValueError, OSError) as e:
                raise StateError("state file %s is unreadable (%s); it is left untouched - "
                                 "restore it from backup or move it away explicitly" % (self.path, e))
        return data

    def _read(self):
        """(normalized data, state_version on disk, number of entries migrated in memory)."""
        data = self._load_raw()
        version = data.get("state_version", 1)
        migrated = normalize_state(data)
        return data, version, migrated

    def _lock(self, name, blocking=True):
        os.makedirs(self.dir, exist_ok=True)
        fh = open(os.path.join(self.dir, name), "a")
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except OSError:
            fh.close()
            return None
        return fh

    def acquire_run_lock(self):
        """Exclusive lock for a mutating run (start/classify); False if another run holds it."""
        self._run_lock = self._lock("run.lock", blocking=False)
        return self._run_lock is not None

    def _atomic_write(self, path, text):
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        _fsync_dir(self.dir)

    def _backup_old_layout(self):
        """Keep the pre-migration file once (state.v1.json), before it is rewritten."""
        backup = os.path.join(self.dir, self.BACKUP)
        if os.path.exists(backup) or not os.path.isfile(self.path):
            return
        with open(self.path, encoding="utf-8") as f:
            raw = f.read()
        try:
            on_disk = json.loads(raw)
        except ValueError:
            return
        if isinstance(on_disk, dict) and on_disk.get("state_version", 1) != STATE_VERSION:
            self._atomic_write(backup, raw)

    def _write(self, data):
        self._backup_old_layout()
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.path)
        _fsync_dir(self.dir)

    def save(self):
        lock = self._lock("state.lock")
        try:
            self.data["paused"] = self._load_raw().get("paused", False)
            normalize_state(self.data)
            self._write(self.data)
        finally:
            lock.close()

    def set_paused(self, value):
        lock = self._lock("state.lock")
        try:
            data, _, _ = self._read()
            data["paused"] = bool(value)
            self._write(data)
            self.data = data
        finally:
            lock.close()

    def domain(self, name):
        return self.data["domains"].get(name)

    def put_domain(self, name, entry):
        self.data["domains"][name] = entry

    def profile_entry(self, name, profile):
        """Crawl state of (domain, profile), or None if this pair is unknown."""
        entry = self.domain(name)
        if not entry:
            return None
        return (entry.get("profiles") or {}).get(profile)

    def put_profile_entry(self, name, profile, pentry, now):
        """Store the crawl state of (domain, profile); other profiles and classifications stay."""
        entry = self.data["domains"].setdefault(name, {"domain": name, "profiles": {}})
        entry.setdefault("domain", name)
        entry.setdefault("first_seen", pentry.get("first_seen", now))
        entry.setdefault("profiles", {})[profile] = pentry

    def migrate(self):
        """Write the normalized state now (explicit migration)."""
        self.save()


def _fsync_dir(path):
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def open_state(args, run=False):
    """State for a command; run=True takes the run lock (start/classify, not for dry runs)."""
    try:
        st = State(env_workdir(args.workdir))
    except StateError as e:
        sys.exit(json.dumps({"error": {"code": "state_unreadable", "message": str(e)}}))
    if run and not st.acquire_run_lock():
        sys.exit(json.dumps({"error": {"code": "busy", "message": "another start/classify run is active"}}))
    return st


def env_workdir(explicit):
    if explicit:
        return explicit
    return os.environ.get("SCOUTRO_DISCOVERY_DIR", os.path.expanduser("~/.scoutro-discovery"))


def make_client(args):
    pw = args.password or os.environ.get("SCOUTRO_PASSWORD")
    if not pw:
        path = os.environ.get("SCOUTRO_PASSWORD_FILE")
        if path:
            with open(path, encoding="utf-8") as f:
                pw = f.readline().rstrip("\r\n")
    base = args.url or os.environ.get("SCOUTRO_URL", "http://127.0.0.1:8090")
    user = args.user or os.environ.get("SCOUTRO_USER", "admin")
    return Client(base, user, pw)


