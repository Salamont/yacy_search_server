def load_profiles(path):
    profiles = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            name, rest = line.split("=", 1)
            terms = [t.strip() for t in rest.split(";") if t.strip()]
            if name.strip() and terms:
                profiles[name.strip()] = terms
    return profiles


def load_regions(path):
    regions = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                regions.append(line)
    return regions


class State:
    def __init__(self, directory):
        self.dir = directory
        self.path = os.path.join(directory, "state.json")
        self.data = {"paused": False, "profiles": {}, "domains": {}}
        if os.path.isfile(self.path):
            try:
                with open(self.path, encoding="utf-8") as f:
                    self.data.update(json.load(f))
            except (ValueError, OSError):
                pass

    def save(self):
        os.makedirs(self.dir, exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2, ensure_ascii=False)
        os.replace(tmp, self.path)

    def domain(self, name):
        return self.data["domains"].get(name)

    def put_domain(self, name, entry):
        self.data["domains"][name] = entry


def env_workdir(explicit):
    if explicit:
        return explicit
    return os.environ.get("SCOUTRO_DISCOVERY_DIR", os.path.expanduser("~/.scoutro-discovery"))


def make_client(args):
    pw = args.password or os.environ.get("SCOUTRO_PASSWORD")
    if not pw:
        path = os.environ.get("SCOUTRO_PASSWORD_FILE")
        if path:
            with open(path, encoding="utf-8") as f:
                pw = f.readline().rstrip("\r\n")
    base = args.url or os.environ.get("SCOUTRO_URL", "http://127.0.0.1:8090")
    user = args.user or os.environ.get("SCOUTRO_USER", "admin")
    return Client(base, user, pw)


