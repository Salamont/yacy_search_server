def cmd_status(args):
    st = State(env_workdir(args.workdir))
    doms = st.data["domains"]
    by_profile = {}
    for d, e in doms.items():
        p = e.get("profile", "?")
        by_profile.setdefault(p, {"domains": 0, "crawled": 0})
        by_profile[p]["domains"] += 1
        if e.get("status") == "crawled":
            by_profile[p]["crawled"] += 1
    print(json.dumps({
        "paused": st.data.get("paused", False),
        "total_domains": len(doms),
        "profiles": by_profile,
        "state_file": st.path,
    }, indent=2, ensure_ascii=False))


def cmd_pause(args):
    st = State(env_workdir(args.workdir))
    st.data["paused"] = True
    st.save()
    print(json.dumps({"paused": True, "state_file": st.path}, indent=2))


def cmd_resume(args):
    st = State(env_workdir(args.workdir))
    st.data["paused"] = False
    st.save()
    print(json.dumps({"paused": False, "state_file": st.path}, indent=2))


def discover_candidates(client, profiles, regions, profile, term_limit, region_limit, region_cursor, net_limit):
    """Return (candidates, new_cursor). candidates = [{url,host,title,term,region}]."""
    terms = profiles[profile][:term_limit]
    regs = regions[region_cursor:] + regions[:region_cursor]
    regs = regs[:region_limit]
    out = []
    for term in terms:
        for region in regs:
            q = f"{term} {region}"
            try:
                res = client.search(q, source="network", limit=net_limit)
            except ApiError as e:
                sys.stderr.write(f"  discovery error for '{q}': {e}\n")
                continue
            for r in res.get("results", []):
                url = r.get("url", "")
                host = urllib.parse.urlsplit(url).hostname or r.get("host", "")
                out.append({"url": url, "host": (host or "").lower(), "title": r.get("title", ""),
                            "term": term, "region": region})
    new_cursor = (region_cursor + region_limit) % max(1, len(regions))
    return out, new_cursor


def select_domains(candidates, profile, state, force, max_domains, now, recrawl_days, require_tld=True):
    accepted = {}
    rejected = {}
    for c in candidates:
        reason = blocked_reason(c["url"], c["host"])
        if reason:
            rejected[reason] = rejected.get(reason, 0) + 1
            continue
        rd = registrable_domain(c["host"])
        if not rd:
            rejected["no-registrable"] = rejected.get("no-registrable", 0) + 1
            continue
        if require_tld and REQUIRED_TLDS and not rd.endswith(REQUIRED_TLDS):
            rejected["not-de"] = rejected.get("not-de", 0) + 1
            continue
        accepted.setdefault(rd, c)
    selected = []
    for rd, c in accepted.items():
        entry = state.domain(rd)
        if entry and not force:
            if entry.get("next_attempt", 0) > now:
                continue
            last = entry.get("last_crawl", 0)
            if entry.get("status") == "crawled" and (now - last) < recrawl_days * 86400:
                continue
        selected.append((rd, c))
        if len(selected) >= max_domains:
            break
    return selected, accepted, rejected


# ---------------------------------------------------------------------------
# OSM / Geofabrik discovery source
# ---------------------------------------------------------------------------

OSM_BASE_URL = "https://download.geofabrik.de/europe/germany/%s-latest.osm.pbf"


def _ogr2ogr(argv):
    if shutil.which("ogr2ogr") is None:
        sys.exit("--source osm needs ogr2ogr (GDAL OSM driver); install the 'gdal-tools' package")
    subprocess.run(["ogr2ogr"] + argv, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def download_pbf(slug, dest):
    url = OSM_BASE_URL % slug
    sys.stderr.write("  downloading " + url + "\n")
    subprocess.run(["curl", "-sL", "-o", dest, url], check=True)


def extract_region(pbf, where, workdir):
    out = {}
    for layer in ("points", "multipolygons"):
        gj = os.path.join(workdir, os.path.basename(pbf) + "." + layer + ".geojson")
        _ogr2ogr(["-f", "GeoJSON", gj, pbf, layer, "-where", where])
        out[layer] = gj
    return out


def collect_osm_candidates(regions, profile_names, osm_cfg, workdir, keep_pbf):
    """Extract candidate websites from Geofabrik PBF extracts (OSM is discovery only)."""
    osm_dir = os.path.join(workdir, "osm")
    os.makedirs(osm_dir, exist_ok=True)
    where = osm_cfg["extract"]
    text_fields = osm_cfg["text_fields"]
    web_fields = osm_cfg["website_fields"]
    rules = osm_cfg["profiles"]
    candidates = {p: {} for p in profile_names}
    stats = {}
    for slug in regions:
        pbf = os.path.join(osm_dir, slug + ".osm.pbf")
        if not os.path.isfile(pbf):
            download_pbf(slug, pbf)
        stats[slug] = {p: {"objects": 0, "with_website": 0, "missing_website": 0, "domains": 0} for p in profile_names}
        domains = {p: set() for p in profile_names}
        geojsons = extract_region(pbf, where, osm_dir)
        for gj in geojsons.values():
            with open(gj, encoding="utf-8") as fh:
                data = json.load(fh)
            for feat in data.get("features", []):
                props = feat.get("properties", {}) or {}
                tags = parse_hstore(props.get("other_tags", ""))
                if props.get("name"):
                    tags.setdefault("name", props["name"])
                for p in profile_names:
                    rule = dict(rules.get(p, {}))
                    rule["_text_fields"] = text_fields
                    if not osm_matches(tags, rule):
                        continue
                    st = stats[slug][p]
                    st["objects"] += 1
                    web = osm_website(tags, web_fields)
                    if not web:
                        st["missing_website"] += 1
                        continue
                    st["with_website"] += 1
                    host = (urllib.parse.urlsplit(web).hostname or "").lower()
                    rd = registrable_domain(host)
                    if not rd:
                        continue
                    domains[p].add(rd)
                    candidates[p].setdefault(rd, {"url": web, "host": host, "title": tags.get("name", ""),
                                                  "source": "osm", "region": tags.get("addr:city", slug)})
        for p in profile_names:
            stats[slug][p]["domains"] = len(domains[p])
        if not keep_pbf:
            for fp in [pbf] + list(geojsons.values()):
                try:
                    os.remove(fp)
                except OSError:
                    pass
    return candidates, stats


def cmd_start(args):
    cfg = args.config_dir or DEFAULT_CONFIG_DIR
    profiles = load_profiles(os.path.join(cfg, "profiles.conf"))
    regions = load_regions(os.path.join(cfg, "regions.txt"))
    if not profiles:
        sys.exit("config missing: profiles.conf in " + cfg)
    names = [args.profile] if args.profile else list(profiles)
    for n in names:
        if n not in profiles:
            sys.exit("unknown profile: " + n)

    st = State(env_workdir(args.workdir))
    if st.data.get("paused") and not args.dry_run:
        sys.exit("discovery is paused (run 'resume' first)")
    client = make_client(args)
    now = int(time.time())
    source = args.source

    osm_candidates, osm_stats = {}, {}
    if source in ("osm", "both"):
        if not args.region:
            sys.exit("--source %s needs at least one --region (e.g. --region berlin)" % source)
        osm_cfg = load_osm_config(args.osm_config or os.path.join(cfg, "osm_profiles.json"))
        osm_candidates, osm_stats = collect_osm_candidates(
            args.region, names, osm_cfg, env_workdir(args.workdir), args.keep_pbf)

    report = {}
    for name in names:
        rejected = {}
        selected = []
        n_fw = n_osm = 0
        if source in ("freeworld", "both") and regions:
            cursor = st.data["profiles"].get(name, {}).get("region_cursor", 0)
            fw, new_cursor = discover_candidates(client, profiles, regions, name,
                                                 args.limit_terms, args.limit_regions, cursor, args.net_limit)
            st.data["profiles"].setdefault(name, {})["region_cursor"] = new_cursor
            n_fw = len(fw)
            sel, _acc, rej = select_domains(fw, name, st, args.force, args.max_domains, now,
                                            args.recrawl_days, require_tld=True)
            selected += sel
            for k, v in rej.items():
                rejected[k] = rejected.get(k, 0) + v
        if source in ("osm", "both"):
            osm_list = list(osm_candidates.get(name, {}).values())
            n_osm = len(osm_list)
            sel, _acc, rej = select_domains(osm_list, name, st, args.force, args.max_domains, now,
                                            args.recrawl_days, require_tld=False)
            selected += sel
            for k, v in rej.items():
                rejected[k] = rejected.get(k, 0) + v

        seen = set()
        uniq = []
        for rd, c in selected:
            if rd in seen:
                continue
            seen.add(rd)
            uniq.append((rd, c))
        selected = uniq[:args.max_domains]

        started = []
        robots_blocked = 0
        for rd, c in selected:
            entry = st.domain(rd) or {}
            entry.update({"profile": name, "domain": rd, "candidate_url": c["url"]})
            entry.setdefault("first_seen", now)
            if args.dry_run:
                started.append({"domain": rd, "url": c["url"], "source": c.get("source", ""), "status": "dry-run"})
                continue
            ok, info = resolve_public(c["host"])
            if not ok:
                entry.update({"status": "blocked", "attempts": entry.get("attempts", 0) + 1,
                              "last_error": info, "next_attempt": now + 86400})
                st.put_domain(rd, entry)
                started.append({"domain": rd, "status": "blocked:" + info})
                continue
            ro, rreason = robots_allows(c["host"])
            if not ro:
                robots_blocked += 1
                entry.update({"status": "robots", "attempts": entry.get("attempts", 0) + 1,
                              "last_error": rreason, "next_attempt": now + args.recrawl_days * 86400})
                st.put_domain(rd, entry)
                started.append({"domain": rd, "status": "robots:" + rreason})
                continue
            try:
                res = client.crawl_start(c["url"], "prospect-" + name,
                                         depth=args.depth, max_pages=args.max_pages)
                entry.update({"status": "crawled", "last_crawl": now, "attempts": 0, "last_error": "",
                              "next_attempt": now + args.recrawl_days * 86400, "crawl_id": res.get("id")})
                st.put_domain(rd, entry)
                started.append({"domain": rd, "url": c["url"], "crawl_id": res.get("id"), "status": "started"})
            except ApiError as e:
                attempts = entry.get("attempts", 0) + 1
                backoff = min(args.recrawl_days * 86400, (2 ** attempts) * 3600)
                entry.update({"status": "error", "attempts": attempts, "last_error": str(e),
                              "next_attempt": now + backoff})
                st.put_domain(rd, entry)
                started.append({"domain": rd, "status": "error:" + str(e)})
            time.sleep(args.delay)
        entry_report = {
            "source": source,
            "freeworld_candidates": n_fw,
            "osm_candidates": n_osm,
            "rejected_by_reason": rejected,
            "robots_blocked": robots_blocked,
            "processed": started,
        }
        if source in ("osm", "both"):
            entry_report["osm_regions"] = {r: osm_stats.get(r, {}).get(name, {}) for r in (args.region or [])}
        report[name] = entry_report
    if not args.dry_run:
        st.save()
    print(json.dumps(report, indent=2, ensure_ascii=False))


def cmd_search(args):
    client = make_client(args)
    q = "collection:prospect-" + args.profile + " " + args.query
    print(json.dumps(client.search(q, source="local", limit=args.limit), indent=2, ensure_ascii=False))


def cmd_selftest(args):
    checks = []

    def expect(url, host, blocked):
        reason = blocked_reason(url, host)
        ok = (reason is not None) if blocked else (reason is None)
        checks.append((ok, f"{'block' if blocked else 'allow'} {url} -> {reason}"))

    expect("https://www.example-firma.de/", "www.example-firma.de", False)
    expect("https://example.de/kontakt", "example.de", False)
    expect("https://example.com/download/file.zip", "example.com", True)
    expect("https://example.com/setup.exe", "example.com", True)
    expect("ftp://example.com/file", "example.com", True)
    expect("https://de.wikipedia.org/wiki/Pflegeheim", "de.wikipedia.org", True)
    expect("https://github.com/foo/bar", "github.com", True)
    expect("https://example.com/a.pdf", "example.com", True)
    expect("https://example.com/wp-content/uploads/x", "example.com", True)
    expect("https://example.com:8080/", "example.com", False)
    # SSRF / private targets
    ok, info = is_public_ip("127.0.0.1"), "loopback"
    checks.append((not ok, "private 127.0.0.1 blocked"))
    checks.append((not is_public_ip("192.168.1.10"), "private 192.168.x.x blocked"))
    checks.append((not is_public_ip("10.0.0.5"), "private 10.x blocked"))
    checks.append((not is_public_ip("169.254.1.1"), "link-local blocked"))
    checks.append((is_public_ip("8.8.8.8"), "public 8.8.8.8 allowed"))
    checks.append((registrable_domain("www.firma.de") == "firma.de", "registrable www.firma.de"))
    checks.append((registrable_domain("a.b.example.co.uk") == "example.co.uk", "registrable co.uk"))
    # content is untrusted data: nothing here executes web content
    checks.append((True, "no JS execution by design (static HTTP only)"))

    failed = [c for c in checks if not c[0]]
    for ok, msg in checks:
        print(("ok   " if ok else "FAIL ") + msg)
    print(f"\nselftest: {len(checks) - len(failed)}/{len(checks)} passed")
    sys.exit(1 if failed else 0)


def main():
    p = argparse.ArgumentParser(prog="scoutro-discovery",
                                description="Germany-wide prospect discovery for Scoutro/YaCy (uses only the Scoutro API).")
    p.add_argument("--url", help="Scoutro base URL (default $SCOUTRO_URL or http://127.0.0.1:8090)")
    p.add_argument("--user", help="admin user (default $SCOUTRO_USER or admin)")
    p.add_argument("--password", help="admin password (prefer $SCOUTRO_PASSWORD_FILE)")
    p.add_argument("--workdir", help="state directory (default $SCOUTRO_DISCOVERY_DIR or ~/.scoutro-discovery)")
    p.add_argument("--config-dir", help="directory with profiles.conf and regions.txt")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="show discovery state").set_defaults(func=cmd_status)
    sub.add_parser("pause", help="pause discovery").set_defaults(func=cmd_pause)
    sub.add_parser("resume", help="resume discovery").set_defaults(func=cmd_resume)
    sub.add_parser("selftest", help="run filter/SSRF self-tests").set_defaults(func=cmd_selftest)

    s = sub.add_parser("start", help="discover and crawl prospect domains")
    s.add_argument("--profile", help="only this profile (default: all)")
    s.add_argument("--source", choices=["freeworld", "osm", "both"], default="freeworld",
                   help="discovery source (default freeworld; osm uses Geofabrik PBF extracts)")
    s.add_argument("--region", action="append", default=[], help="OSM region slug, repeatable (e.g. --region berlin)")
    s.add_argument("--keep-pbf", action="store_true", help="keep downloaded PBF and GeoJSON (default: delete)")
    s.add_argument("--osm-config", help="path to osm_profiles.json")
    s.add_argument("--limit-terms", type=int, default=8)
    s.add_argument("--limit-regions", type=int, default=5)
    s.add_argument("--net-limit", type=int, default=20, help="P2P results per query")
    s.add_argument("--max-domains", type=int, default=5, help="max new domains per profile per run")
    s.add_argument("--depth", type=int, default=2)
    s.add_argument("--max-pages", type=int, default=15)
    s.add_argument("--delay", type=float, default=2.0)
    s.add_argument("--recrawl-days", type=int, default=30)
    s.add_argument("--force", action="store_true", help="ignore recrawl/backoff")
    s.add_argument("--dry-run", action="store_true", help="discover+filter only, do not crawl")
    s.set_defaults(func=cmd_start)

    q = sub.add_parser("search", help="search one prospect collection locally")
    q.add_argument("--profile", required=True)
    q.add_argument("--query", required=True)
    q.add_argument("--limit", type=int, default=10)
    q.set_defaults(func=cmd_search)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
