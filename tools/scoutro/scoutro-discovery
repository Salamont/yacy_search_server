# filtering (DISCOVERY RESULT -> ACCEPTED DOMAIN)
# ---------------------------------------------------------------------------

# blocked file types (archives, programs, media, documents)
BLOCKED_EXT = re.compile(
    r"\.(zip|gz|tgz|tar|bz2|xz|txz|7z|rar|zst|exe|msi|msp|dll|com|scr|bat|cmd|ps1|sh|jar|apk|aab|"
    r"dmg|pkg|iso|img|deb|rpm|appimage|bin|run|mp3|mp4|m4a|avi|mov|mkv|wav|flac|ogg|opus|webm|wmv|flv|"
    r"jpg|jpeg|png|gif|webp|svg|bmp|tif|tiff|ico|heic|avif|pdf|doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp|"
    r"rtf|epub|torrent|dmp|cab|vhd|vmdk)$", re.I)

# blocked host fragments (search engines, wikis, code/package hosts, social,
# file hosts, major news) - kept deliberately conservative and editable
BLOCKED_HOST = (
    "wikipedia.", "wikimedia.", "wiktionary.", "wikiwand.",
    "github.", "gitlab.", "bitbucket.", "sourceforge.", "gitea.", "codeberg.",
    "stackoverflow.", "stackexchange.", "superuser.", "askubuntu.",
