def registrable_domain(host):
    host = (host or "").strip().lower().rstrip(".")
    if not host or IPV4_RE.match(host):
        return host
    parts = host.split(".")
    if len(parts) <= 2:
        return host
    last2 = ".".join(parts[-2:])
    if last2 in MULTI_SUFFIX:
        return ".".join(parts[-3:])
    return last2


def host_matches(host, frag):
    """Match a BLOCKED_HOST entry on DNS label boundaries.

    "wikipedia." matches de.wikipedia.org but not mywikipedia.org;
    "pflege.de" matches pflege.de and www.pflege.de but not sonnenhof-pflege.de.
    """
    if frag.endswith("."):
        return host.startswith(frag) or ("." + frag) in host
    return host == frag or host.endswith("." + frag)


def blocked_reason(url, host):
    """Return a reason string when the candidate must be rejected, else None."""
    if not host:
        return "no-host"
    try:
        u = urllib.parse.urlsplit(url)
    except ValueError:
        return "bad-url"
    if u.scheme.lower() not in ("http", "https"):
        return "scheme:" + (u.scheme or "none")
    if u.username or u.password:
        return "userinfo"
    if IPV4_RE.match(host) or ":" in host:
        return "ip-literal"
    path = (u.path or "").lower()
    if BLOCKED_EXT.search(path):
        return "file-type"
    for frag in BLOCKED_PATH:
        if frag in path:
            return "download-path"
    for frag in BLOCKED_HOST:
        if host_matches(host, frag):
            return "host:" + frag
    if "." not in host:
        return "no-dot"
    return None


def is_public_ip(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return not (a.is_private or a.is_loopback or a.is_link_local or a.is_multicast
                or a.is_reserved or a.is_unspecified)


def resolve_public(host):
    """DNS-resolve and reject private/loopback/link-local/cluster targets (SSRF)."""
    if host.lower() in ("localhost",) or host.lower().endswith(".local"):
        return False, "localhost"
    try:
        infos = socket.getaddrinfo(host, None)
    except socket.gaierror as e:
        return False, "dns:" + str(e)
    ips = {i[4][0] for i in infos}
    for ip in ips:
        if not is_public_ip(ip):
            return False, "private-ip:" + ip
    return True, ",".join(sorted(ips))


def robots_allows(host):
    """Best-effort robots.txt check for our crawler user-agent (yacybot).

    Returns (allowed, reason). allowed is True/False, or None when the site
    answered robots.txt with HTTP 5xx on every scheme (a transient site
    error: do not crawl now, retry later). On any other fetch error we allow
    and let YaCy decide (YaCy re-checks robots.txt itself).
    """
    body = None
    server_errors = []
    for scheme in ("https", "http"):
        try:
            req = urllib.request.Request(scheme + "://" + host + "/robots.txt",
                                         headers={"User-Agent": "yacybot (scoutro-discovery)"})
            with urllib.request.urlopen(req, timeout=8) as r:
                body = r.read(200000).decode("utf-8", "replace")
                break
        except urllib.error.HTTPError as e:
            if 500 <= e.code <= 599:
                server_errors.append(e.code)
            continue
        except Exception:
            continue
    if body is None:
        if len(server_errors) == 2:
            return None, "site-5xx:%d" % server_errors[-1]
        return True, "robots-unreachable"
    group = None
    groups = {}
    for line in body.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        key = key.strip().lower()
        val = val.strip()
        if key == "user-agent":
            group = val.lower()
            groups.setdefault(group, [])
        elif key in ("disallow", "allow") and group is not None:
            groups[group].append((key, val))
    rules = groups.get("yacybot") or groups.get("*") or []
    for key, val in rules:
        if key == "allow" and val in ("/", ""):
            return True, "robots-allow"
    for key, val in rules:
        if key == "disallow" and val in ("/", "/*"):
            return False, "robots-disallow-all"
    return True, "robots-ok"


HSTORE_PAIR = re.compile(r'"((?:[^"\\]|\\.)*)"\s*=>\s*"((?:[^"\\]|\\.)*)"')


def parse_hstore(h):
    out = {}
    if not h:
        return out
    for m in HSTORE_PAIR.finditer(h):
        out[m.group(1).replace('\\"', '"').replace("\\\\", "\\")] = \
            m.group(2).replace('\\"', '"').replace("\\\\", "\\")
    return out


def load_osm_config(path):
    with open(path, encoding="utf-8") as f:
        cfg = json.load(f)
    cfg.setdefault("text_fields", ["name", "description"])
    cfg.setdefault("website_fields", ["website", "contact:website", "url"])
    return cfg


def osm_text_blob(tags, fields):
    return " ".join(str(tags.get(f, "")) for f in fields).lower()


def osm_matches(tags, rule):
    if rule.get("text_any"):
        blob = osm_text_blob(tags, rule.get("_text_fields", ["name", "description"]))
        if any(k.lower() in blob for k in rule["text_any"]):
            return True
    for r in rule.get("tags", []):
        ok = True
        for key, allowed in r.items():
            if key == "text_any":
                blob = osm_text_blob(tags, rule.get("_text_fields", ["name", "description"]))
                if not any(k.lower() in blob for k in allowed):
                    ok = False
                    break
            elif key.startswith("_"):
                continue
            else:
                if tags.get(key) not in allowed:
                    ok = False
                    break
        if ok and any(not k.startswith("_") for k in r):
            return True
    return False


def osm_website(tags, fields):
    for f in fields:
        v = (tags.get(f) or "").strip()
        if v:
            if not v.lower().startswith(("http://", "https://")):
                v = "https://" + v.lstrip("/")
            return v
    return None



# ---------------------------------------------------------------------------
# Scoutro API client (urllib + HTTP Digest, same as scoutroctl)
# ---------------------------------------------------------------------------

class ApiError(Exception):
    def __init__(self, status, code, message):
        super().__init__(f"{status} {code}: {message}")
        self.status = status
        self.code = code
        self.message = message


class AuthFailed(ApiError):
    """Scoutro rejected the administrator credentials (infrastructure/client error, never a domain error)."""

    def __init__(self, message):
        super().__init__(401, "auth_failed", message)


class InfrastructureError(ApiError):
    """Scoutro itself is unreachable or failing; the current domain is not to blame."""


MAX_AUTH_ATTEMPTS = 3


def _digest_challenge(header_values):
    """First Digest challenge among the WWW-Authenticate values, as a dict (or None)."""
    for value in header_values or []:
        scheme, _, rest = value.strip().partition(" ")
        if scheme.lower() == "digest" and rest:
            try:
                return urllib.request.parse_keqv_list(urllib.request.parse_http_list(rest))
            except ValueError:
                return None
    return None


def _quote(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


class Client:
    """Scoutro API client with a stateless HTTP Digest implementation.

    Why not urllib's HTTPDigestAuthHandler: it keeps a retry counter per
    handler that is only reset when the authenticated retry succeeds. When the
    authenticated request itself ends in an HTTP error (e.g. 422 for a
    rejected start URL) the reset is skipped; after six such errors in a row
    the handler answers every further challenge with "401 digest auth failed"
    without even trying. That made crawl.start fail with 401 intermittently.

    Here every request is authenticated from scratch: send, and on a 401 with
    a Digest challenge answer that challenge with a fresh cnonce (nc=1). A 401
    means Scoutro did not execute the request, so repeating it is safe, also
    for POST. At most MAX_AUTH_ATTEMPTS authenticated attempts; then
    AuthFailed ("auth_failed"). Timeouts and network errors are never
    repeated. Credentials are never logged or put into error messages.
    """

    def __init__(self, base_url, user, pw, timeout=None):
        self.base = base_url.rstrip("/") + "/scoutro/api"
        self.timeout = timeout or float(os.environ.get("SCOUTRO_API_TIMEOUT", "60"))
        self.user = user
        self._pw = pw
        self.opener = urllib.request.build_opener()

    def _authorization(self, method, url, chal):
        realm, nonce = chal.get("realm"), chal.get("nonce")
        if realm is None or nonce is None:
            return None
        algorithm = chal.get("algorithm", "MD5")
        alg = algorithm.upper()
        sess = alg.endswith("-SESS")
        base_alg = alg[:-5] if sess else alg
        hashes = {"MD5": hashlib.md5, "SHA-256": hashlib.sha256}
        if base_alg not in hashes:
            return None

        def H(x):
            return hashes[base_alg](x.encode("utf-8")).hexdigest()

        qops = [q.strip().lower() for q in chal.get("qop", "").split(",") if q.strip()]
        if qops and "auth" not in qops:
            return None
        u = urllib.parse.urlsplit(url)
        uri = u.path + ("?" + u.query if u.query else "")
        cnonce = secrets.token_hex(16)
        nc = "00000001"
        ha1 = H("%s:%s:%s" % (self.user, realm, self._pw))
        if sess:
            ha1 = H("%s:%s:%s" % (ha1, nonce, cnonce))
        ha2 = H("%s:%s" % (method, uri))
        if qops:
            response = H("%s:%s:%s:%s:auth:%s" % (ha1, nonce, nc, cnonce, ha2))
        else:
            response = H("%s:%s:%s" % (ha1, nonce, ha2))
        parts = ["username=" + _quote(self.user), "realm=" + _quote(realm), "nonce=" + _quote(nonce),
                 "uri=" + _quote(uri), "algorithm=" + algorithm, "response=" + _quote(response)]
        if "opaque" in chal:
            parts.append("opaque=" + _quote(chal["opaque"]))
        if qops:
            parts += ["qop=auth", "nc=" + nc, "cnonce=" + _quote(cnonce)]
        return "Digest " + ", ".join(parts)

    def call(self, method, path, query=None, body=None):
        url = self.base + path
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        data = None
        headers = {"Accept": "application/json", "User-Agent": "scoutro-discovery/" + VERSION}
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        authorization = None
        auth_attempts = 0
        while True:
            h = dict(headers)
            if authorization:
                h["Authorization"] = authorization
            req = urllib.request.Request(url, data=data, method=method, headers=h)
            try:
                with self.opener.open(req, timeout=self.timeout) as r:
                    return json.loads(r.read().decode("utf-8"))
            except urllib.error.HTTPError as e:
                raw = e.read().decode("utf-8", "replace")
                if e.code != 401:
                    raise self._api_error(e.code, raw)
                # 401: Scoutro did not execute the request -> safe to answer the challenge
                if not self._pw:
                    raise AuthFailed("Scoutro requires the administrator login, but no password is configured "
                                     "(SCOUTRO_PASSWORD_FILE).")
                if auth_attempts >= MAX_AUTH_ATTEMPTS:
                    raise AuthFailed("Scoutro rejected the administrator login after %d authentication attempts "
                                     "(wrong user/password, or an auth problem in front of Scoutro)." % auth_attempts)
                chal = _digest_challenge(e.headers.get_all("WWW-Authenticate") if e.headers else None)
                authorization = self._authorization(method, url, chal) if chal else None
                if chal and authorization is None:
                    raise AuthFailed("Scoutro sent an unsupported HTTP Digest challenge.")
                auth_attempts += 1
            except urllib.error.URLError as e:
                reason = e.reason
                kind = "timeout" if isinstance(reason, (socket.timeout, TimeoutError)) else "unreachable"
                raise InfrastructureError(0, kind, "Scoutro API %s: %s" % (kind, str(reason)[:200]))
            except (socket.timeout, TimeoutError) as e:
                raise InfrastructureError(0, "timeout", "Scoutro API timeout: %s" % str(e)[:200])

    @staticmethod
    def _api_error(status, raw):
        try:
            err = json.loads(raw).get("error", {})
            code, message = err.get("code", "http_error"), err.get("message", raw[:200])
            details = err.get("details") or {}
        except (ValueError, AttributeError):
            code, message, details = "http_error", raw[:200], {}
        e = ApiError(status, code, message)
        e.details = details if isinstance(details, dict) else {}
        return e

    def search(self, q, source="local", limit=10):
        return self.call("GET", "/v1/search", {"q": q, "source": source, "limit": limit})

    def evidence(self, domain, collection=None, limit=8, max_chars=1500):
        return self.call("GET", "/v1/index/evidence", {"domain": domain, "collection": collection,
                                                      "limit": limit, "maxChars": max_chars})

    def crawl_start(self, url, collection, depth=2, max_pages=15, scope="domain"):
        return self.call("POST", "/v1/crawls", body={
            "url": url, "depth": depth, "scope": scope,
            "maxPages": max_pages, "collection": collection})


