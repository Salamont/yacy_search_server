def state_summary(data, now=None):
    """Counts for status: unique domains, (domain, profile) pairs and per-profile states."""
    now = int(time.time()) if now is None else now
    doms = data.get("domains", {})
    profiles = {}

    def prof(p):
        return profiles.setdefault(p, {"domains": 0, "crawled": 0, "retry": 0, "legacy_auth_retry": 0,
                                       "rejected": 0, "robots": 0, "blocked": 0, "fresh": 0, "other": 0,
                                       "due": 0, "classified": {"PASS": 0, "FAIL": 0, "UNSURE": 0}})
    pairs = unassigned = 0
    for e in doms.values():
        if not isinstance(e, dict):
            continue
        if e.get("unassigned"):
            unassigned += 1
        for p, pe in (e.get("profiles") or {}).items():
            pairs += 1
            c = prof(p)
            c["domains"] += 1
            status = pe.get("status") or ""
            if legacy_auth_burned(pe):
                c["legacy_auth_retry"] += 1
            elif status == "crawled":
                c["crawled"] += 1
            elif status in RETRY_STATUSES:
                c["retry"] += 1
            elif status in PROBLEM_STATUSES:
                c[status] += 1
            elif not status:
                c["fresh"] += 1
            else:
                c["other"] += 1
            if selection_kind(pe, now, 30) is not None:
                c["due"] += 1
        for p, rec in (e.get("classifications") or {}).items():
            v = (rec or {}).get("verdict")
            if v in ("PASS", "FAIL", "UNSURE"):
                prof(p)["classified"][v] += 1
    return {"unique_domains": len(doms), "domain_profile_pairs": pairs,
            "unassigned_domains": unassigned, "profiles": dict(sorted(profiles.items()))}


def cmd_status(args):
    st = open_state(args)
    summary = state_summary(st.data)
    print(json.dumps(dict({
        "paused": st.data.get("paused", False),
        "state_version": STATE_VERSION,
        "state_version_on_disk": st.disk_version,
        "migration_pending": st.disk_version != STATE_VERSION,
        "total_domains": summary["unique_domains"],          # name before state_version 2
    }, **summary, state_file=st.path), indent=2, ensure_ascii=False))


def cmd_migrate(args):
    """Rewrite state.json in the current layout (also done by any regular write)."""
    st = open_state(args, run=not args.dry_run)
    losses = migration_losses(st._load_raw().get("domains", {}), st.data["domains"])
    if losses:
        sys.exit(json.dumps({"error": {"code": "migration_would_lose_data", "problems": losses[:20]}}))
    report = {"state_version_on_disk": st.disk_version, "state_version": STATE_VERSION,
              "entries_migrated": st.migrated, "lossless": True, "dry_run": bool(args.dry_run),
              "summary": state_summary(st.data), "state_file": st.path}
    if not args.dry_run and (st.migrated or st.disk_version != STATE_VERSION):
        st.migrate()
        report["backup"] = os.path.join(st.dir, State.BACKUP)
    print(json.dumps(report, indent=2, ensure_ascii=False))


def cmd_pause(args):
    st = open_state(args)
    st.set_paused(True)
    print(json.dumps({"paused": True, "state_file": st.path}, indent=2))


def cmd_resume(args):
    st = open_state(args)
    st.set_paused(False)
    print(json.dumps({"paused": False, "state_file": st.path}, indent=2))


def discover_candidates(client, profiles, regions, profile, term_limit, region_limit, region_cursor, net_limit):
    """Return (candidates, new_cursor). candidates = [{url,host,title,term,region}]."""
    terms = profiles[profile][:term_limit]
    regs = regions[region_cursor:] + regions[:region_cursor]
    regs = regs[:region_limit]
    out = []
    for term in terms:
        for region in regs:
            q = f"{term} {region}"
            try:
                res = client.search(q, source="network", limit=net_limit)
            except ApiError as e:
                sys.stderr.write(f"  discovery error for '{q}': {e}\n")
                continue
            for r in res.get("results", []):
                url = r.get("url", "")
                host = urllib.parse.urlsplit(url).hostname or r.get("host", "")
                out.append({"url": url, "host": (host or "").lower(), "title": r.get("title", ""),
                            "term": term, "region": region})
    new_cursor = (region_cursor + region_limit) % max(1, len(regions))
    return out, new_cursor


# Selection works per (domain, profile): the crawl state of one profile never
# changes the selection for another profile of the same domain.
#
# Selection order for small batches (lower tier first; discovery order inside a tier):
TIER_NEW = 1        # fresh for this profile (or a legacy 401 entry, treated as fresh)
TIER_RECRAWL = 2    # crawled successfully, regular recrawl due
TIER_RETRY = 3      # transient error (DNS, site 5xx, Scoutro upstream), retry due
TIER_PROBLEM = 4    # known problematic start URL (rejected by Scoutro, robots, security block), cooldown over
RETRY_STATUSES = ("retry", "error")        # "error": state written by scoutro-discovery before version 3
PROBLEM_STATUSES = ("rejected", "robots", "blocked")

# report names of the selection reasons, in selection order
KIND_FRESH = "fresh"                        # never really tried for this profile
KIND_LEGACY_AUTH = "legacy_auth_retry"      # old bogus-401 entry, selected like fresh
KIND_RECRAWL = "recrawl"
KIND_RETRY = "retry"
KIND_PROBLEM = "problematic"
KINDS = (KIND_FRESH, KIND_LEGACY_AUTH, KIND_RECRAWL, KIND_RETRY, KIND_PROBLEM)
KIND_TIER = {KIND_FRESH: TIER_NEW, KIND_LEGACY_AUTH: TIER_NEW, KIND_RECRAWL: TIER_RECRAWL,
             KIND_RETRY: TIER_RETRY, KIND_PROBLEM: TIER_PROBLEM}


def legacy_auth_burned(entry):
    """State of scoutro-discovery < 3: status "error" only because the old urllib Digest
    handler answered with HTTP 401 (see Client). The start URL was never tried."""
    return bool(entry) and entry.get("status") == "error" \
        and str(entry.get("last_error", "")).split(" ", 1)[0] == "401"


def selection_kind(pentry, now, recrawl_days, force=False):
    """Selection reason of one (domain, profile) crawl state (KIND_*), or None when not due.

    force: everything is due; the reason is still reported.
    """
    if not pentry or not pentry.get("status"):
        return KIND_FRESH
    if legacy_auth_burned(pentry):
        return KIND_LEGACY_AUTH
    status = pentry.get("status")
    if status == "crawled":
        kind = KIND_RECRAWL
    elif status in RETRY_STATUSES:
        kind = KIND_RETRY
    else:
        kind = KIND_PROBLEM
    if force:
        return kind
    if pentry.get("next_attempt", 0) > now:
        return None
    if kind == KIND_RECRAWL and (now - pentry.get("last_crawl", 0)) < recrawl_days * 86400:
        return None
    return kind


def selection_tier(pentry, now, recrawl_days, force=False):
    """Tier of a (domain, profile) crawl state, or None when it is not due. force: one tier."""
    kind = selection_kind(pentry, now, recrawl_days, force)
    if kind is None:
        return None
    return TIER_NEW if force else KIND_TIER[kind]


def select_domains(candidates, profile, state, force, max_domains, now, recrawl_days, require_tld=True):
    """Filter candidates and pick domains that are due for this profile, fresh ones first (see TIER_*).

    Returns (selected, accepted, rejected); selected = [(domain, candidate, tier, info)],
    info = {"kind": KIND_*, "globally_new": the domain is not in the state at all},
    ordered by tier, at most max_domains. Nothing is ever removed from the state.
    """
    accepted = {}
    rejected = {}
    for c in candidates:
        reason = blocked_reason(c["url"], c["host"])
        if reason:
            rejected[reason] = rejected.get(reason, 0) + 1
            continue
        rd = registrable_domain(c["host"])
        if not rd:
            rejected["no-registrable"] = rejected.get("no-registrable", 0) + 1
            continue
        if require_tld and REQUIRED_TLDS and not rd.endswith(REQUIRED_TLDS):
            rejected["not-de"] = rejected.get("not-de", 0) + 1
            continue
        accepted.setdefault(rd, c)
    eligible = []
    for rd, c in accepted.items():
        pentry = state.profile_entry(rd, profile)
        kind = selection_kind(pentry, now, recrawl_days, force)
        if kind is not None:
            tier = TIER_NEW if force else KIND_TIER[kind]
            eligible.append((rd, c, tier, {"kind": kind, "globally_new": state.domain(rd) is None}))
    eligible.sort(key=lambda x: x[2])       # stable: discovery order inside a tier
    return eligible[:max_domains], accepted, rejected


def classify_api_error(e):
    """Error class of a failed crawl.start (structured status/code only, never message text).

    rejected   - Scoutro/YaCy refused this start URL (422 crawl_rejected, or 400 for the url field)
    transient  - Scoutro could not complete the start for this URL right now (502 upstream_error)
    infrastructure - anything else: Scoutro/API/client problem, not the domain's fault
    """
    if e.status == 422 and e.code == "crawl_rejected":
        return "rejected"
    if e.status == 400 and getattr(e, "details", {}).get("field") == "url":
        return "rejected"
    if e.status == 502 and e.code == "upstream_error":
        return "transient"
    return "infrastructure"


def mark_retry(entry, error_class, error, now, recrawl_days, http_status=None):
    attempts = entry.get("attempts", 0) + 1
    backoff = min(recrawl_days * 86400, (2 ** attempts) * 3600)
    entry.update({"status": "retry", "error_class": error_class, "attempts": attempts, "last_error": error,
                  "last_http_status": http_status, "next_attempt": now + backoff})


