class RemoteError(Exception):
    def __init__(self, service, status, code, message):
        super().__init__("%s %s %s: %s" % (service, status, code, message))
        self.service = service
        self.status = status
        self.code = code
        self.message = message


def _http(method, url, body=None, headers=None, timeout=60):
    data = None
    hdrs = dict(headers or {})
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        hdrs.setdefault("Content-Type", "application/json")
    request = urllib.request.Request(url, data=data, method=method, headers=hdrs)
    opener = urllib.request.build_opener(urllib.request.HTTPRedirectHandler())
    try:
        with opener.open(request, timeout=timeout) as response:
            return response.status, response.headers, response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, e.headers, e.read().decode("utf-8", "replace")


class Scoutro:
    """Scoutro agent API with the worker's own token."""

    def __init__(self, base_url, token, timeout=90):
        self.base = base_url.rstrip("/")
        self.token = token
        self.timeout = timeout

    def call(self, method, path, query=None, body=None, headers=None):
        url = self.base + path
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        hdrs = {"Authorization": "Bearer " + self.token, "Accept": "application/json",
                "User-Agent": "scoutro-agent-bridge/" + VERSION}
        hdrs.update(headers or {})
        try:
            status, _, text = _http(method, url, body, hdrs, self.timeout)
        except (urllib.error.URLError, OSError) as e:
            raise RemoteError("scoutro", 0, "unreachable", "Scoutro is not reachable: %s" % getattr(e, "reason", e))
        try:
            payload = json.loads(text) if text else {}
        except ValueError:
            raise RemoteError("scoutro", status, "invalid_response", "Scoutro answered with non-JSON (HTTP %d)" % status)
        if status >= 400:
            err = payload.get("error", {}) if isinstance(payload, dict) else {}
            raise RemoteError("scoutro", status, err.get("code", "http_%d" % status), err.get("message", ""))
        return status, payload


class Clustro:
    """Clustro MCP (Streamable HTTP, stateless) and webhook with the connection's agent key."""

    def __init__(self, base_url, key, workspace, connection, timeout=30):
        self.base = base_url.rstrip("/")
        self.key = key
        self.workspace = workspace
        self.connection = connection
        self.timeout = timeout
        self._id = 0
        self.last_ok = 0

    def tool(self, name, arguments):
        self._id += 1
        body = {"jsonrpc": "2.0", "id": self._id, "method": "tools/call",
                "params": {"name": name, "arguments": arguments}}
        headers = {"Authorization": "Bearer " + self.key, "Accept": "application/json, text/event-stream"}
        try:
            status, _, text = _http("POST", self.base + "/mcp", body, headers, self.timeout)
        except (urllib.error.URLError, OSError) as e:
            raise RemoteError("clustro", 0, "unreachable", "Clustro is not reachable: %s" % getattr(e, "reason", e))
        if status >= 400:
            raise RemoteError("clustro", status, "http_%d" % status, text[:300])
        message = None
        for line in text.splitlines():
            if line.startswith("data:"):
                message = line[5:].strip()
                break
        try:
            payload = json.loads(message if message is not None else text)
        except ValueError:
            raise RemoteError("clustro", status, "invalid_response", "MCP answer is not JSON")
        if "error" in payload:
            raise RemoteError("clustro", status, "jsonrpc_%s" % payload["error"].get("code"),
                              payload["error"].get("message", ""))
        result = payload.get("result", {})
        content = (result.get("content") or [{}])[0].get("text", "")
        if result.get("isError"):
            raise RemoteError("clustro", status, "tool_error", content[:500])
        self.last_ok = int(time.time() * 1000)
        try:
            return json.loads(content) if content else None
        except ValueError:
            return content

    def webhook(self, event, run_id, data=None):
        body = {"event": event, "runId": run_id}
        if data is not None:
            body["data"] = data
        status, _, text = _http("POST", self.base + "/webhook", body,
                                {"Authorization": "Bearer " + self.key}, self.timeout)
        if status >= 400:
            raise RemoteError("clustro", status, "webhook_%d" % status, text[:300])

    def runs(self, status):
        out = self.tool("list_runs", {"workspaceId": self.workspace, "status": status})
        return out if isinstance(out, list) else []

    def run_status(self, run_id):
        out = self.tool("get_run_status", {"workspaceId": self.workspace, "runId": run_id})
        return (out or {}).get("status", "")

    def complete(self, run_id, output):
        return self.tool("complete_run", {"workspaceId": self.workspace, "runId": run_id, "output": output,
                                          "idempotencyKey": "complete-" + run_id})

    def fail(self, run_id, error):
        return self.tool("fail_run", {"workspaceId": self.workspace, "runId": run_id, "error": error[:2000],
                                      "idempotencyKey": "fail-" + run_id})


