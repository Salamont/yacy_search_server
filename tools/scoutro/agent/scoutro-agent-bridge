def log(event, **fields):
    fields.update({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "event": event})
    sys.stderr.write(json.dumps(fields, ensure_ascii=False) + "\n")


def load_schema(name):
    with open(os.path.join(SCHEMA_DIR, name), encoding="utf-8") as f:
        return json.load(f)


def load_discovery():
    """The discovery tool as a module (State, registrable_domain, profile rules)."""
    path = os.path.join(SCOUTRO_TOOLS, "scoutro-discovery")
    loader = importlib.machinery.SourceFileLoader("scoutro_discovery", path)
    spec = importlib.util.spec_from_loader("scoutro_discovery", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


