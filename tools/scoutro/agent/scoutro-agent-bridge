def read_secret(path):
    try:
        with open(path, encoding="utf-8") as f:
            secret = json.load(f)
    except (OSError, ValueError) as e:
        raise SystemExit("cannot read the runtime secret %s: %s" % (path, e))
    missing = [k for k in ("scoutroToken", "clustroBaseUrl", "clustroWorkspaceId", "clustroConnectionId",
                           "clustroAgentKey") if not secret.get(k)]
    if missing:
        raise SystemExit("the runtime secret %s lacks %s; complete it in Agents & Access "
                         "(Clustro settings, then rotate the token)" % (path, ", ".join(missing)))
    return secret


def build_worker(args, environ=os.environ):
    if args.secret_file:
        secret_path = args.secret_file
    elif args.agent:
        if not re.match(r"^agt_[a-z2-7]{12}$", args.agent):
            raise SystemExit("invalid agent id")
        directory = environ.get("SCOUTRO_AGENT_SECRETS_DIR", os.path.join("DATA", "SETTINGS", "agent-runtime"))
        secret_path = os.path.join(directory, args.agent + ".secret")
    else:
        raise SystemExit("give --agent ID or --secret-file PATH")
    secret = read_secret(secret_path)
    state_dir = environ.get("SCOUTRO_AGENT_STATE_DIR") or os.path.splitext(secret_path)[0] + ".state"
    discovery_dir = environ.get("SCOUTRO_DISCOVERY_DIR") or os.path.join(state_dir, "discovery")
    scoutro = Scoutro(environ.get("SCOUTRO_AGENT_URL", DEFAULT_URL), secret["scoutroToken"])
    clustro = Clustro(secret["clustroBaseUrl"], secret["clustroAgentKey"], secret["clustroWorkspaceId"],
                      secret["clustroConnectionId"])
    llm = sc.LlmConfig.from_env(environ)
    return Worker(scoutro, clustro, Journal(state_dir), llm, discovery_dir,
                  poll=float(environ.get("SCOUTRO_AGENT_POLL", "15")))


def main(argv=None):
    p = argparse.ArgumentParser(prog="scoutro-agent-bridge", description="Scoutro research worker for Clustro (pull).")
    p.add_argument("--agent", help="agent id (reads DATA/SETTINGS/agent-runtime/<id>.secret)")
    p.add_argument("--secret-file", help="path of the runtime secret")
    p.add_argument("--once", action="store_true", help="handle the waiting runs once and exit")
    args = p.parse_args(argv)
    worker = build_worker(args)
    stop = {"now": False}
    signal.signal(signal.SIGTERM, lambda *a: stop.update(now=True))
    log("worker_started", version=VERSION, scoutro=worker.scoutro.base, clustro=worker.clustro.base,
        modelConfigured=bool(worker.llm.configured))
    while True:
        worker.poll_once()
        if args.once or stop["now"]:
            return 0
        slept = 0.0
        while slept < worker.poll and not stop["now"]:
            time.sleep(0.5)
            slept += 0.5
        if stop["now"]:
            return 0


if __name__ == "__main__":
    sys.exit(main())
