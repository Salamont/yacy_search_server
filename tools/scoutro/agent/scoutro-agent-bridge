# journal (restart safety, no double work)
# ---------------------------------------------------------------------------

class Journal:
    """runId -> {state: started|done|failed|skipped, attempts, startedAt}; written atomically."""

    def __init__(self, directory):
        os.makedirs(directory, mode=0o700, exist_ok=True)
        self.path = os.path.join(directory, "journal.json")
        self.runs = {}
        if os.path.isfile(self.path):
            with open(self.path, encoding="utf-8") as f:
                self.runs = json.load(f).get("runs", {})

    def get(self, run_id):
        return self.runs.get(run_id)

    def put(self, run_id, **fields):
        entry = self.runs.setdefault(run_id, {})
        entry.update(fields)
        entry["updatedAt"] = int(time.time())
        self._prune()
        tmp = self.path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"version": 1, "runs": self.runs}, f)
        os.replace(tmp, self.path)

    def _prune(self, keep=5000):
        if len(self.runs) > keep:
            for rid in sorted(self.runs, key=lambda r: self.runs[r].get("updatedAt", 0))[:len(self.runs) - keep]:
                del self.runs[rid]


