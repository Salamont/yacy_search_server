class TaskError(Exception):
    """A task that cannot be done; reported with fail_run and this message."""


class Cancelled(Exception):
    pass


def parse_task(content):
    text = (content or "").strip()
    if not text:
        raise TaskError("the run has no content")
    if text.startswith("{"):
        try:
            task = json.loads(text)
        except ValueError:
            raise TaskError("the run content looks like JSON but is not valid JSON")
        if isinstance(task, dict) and "scoutro_task" in task:
            errors = sc.validate(task, load_schema("task.schema.json"))
            if errors:
                # name the most useful error: the one of the alternative with the matching type
                schema = load_schema("task.schema.json")
                for alt in schema["oneOf"]:
                    if alt["properties"]["type"].get("const") == task.get("type"):
                        errors = sc.validate(task, alt) or errors
                        break
                raise TaskError("invalid task (see tools/scoutro/agent/schemas/task.schema.json): " + "; ".join(errors[:3]))
            if task["type"] == "portal_evaluation" and ("query" in task) == ("domains" in task):
                raise TaskError("a portal_evaluation task needs exactly one of 'query' or 'domains'")
            return task
    if "collection:" in text.lower():
        raise TaskError("the research question must not contain 'collection:'")
    return {"scoutro_task": "1", "type": "research", "query": text[:200]}


class Worker:

    def __init__(self, scoutro, clustro, journal, llm, discovery_dir, profiles_path=None, poll=15, now=time.time):
        self.scoutro = scoutro
        self.clustro = clustro
        self.journal = journal
        self.llm = llm
        self.discovery_dir = discovery_dir
        self.profiles_path = profiles_path or os.path.join(SCOUTRO_TOOLS, "discovery", "profiles.json")
        self.poll = poll
        self.now = now
        self.caps = None
        self.active_runs = 0
        self.last_error = ""
        self.last_poll = 0
        self._discovery = None

    # --- capabilities -------------------------------------------------------

    def capabilities(self):
        _, self.caps = self.scoutro.call("GET", "/capabilities")
        return self.caps

    def granted(self, action):
        return any(a.get("name") == action for a in (self.caps or {}).get("actions", []))

    def scope(self):
        s = (self.caps or {}).get("scope", {})
        return s.get("collections", []), bool(s.get("allCollections"))

    def limits(self):
        return (self.caps or {}).get("limits", {})

    def model_usable(self):
        return bool(self.limits().get("modelAllowed")) and self.llm is not None and self.llm.configured

    # --- loop ---------------------------------------------------------------

    def heartbeat(self, status):
        body = {"version": VERSION, "status": status, "clustroReachable": self.clustro.last_ok > 0,
                "clustroCheckedAt": self.clustro.last_ok, "modelConfigured": bool(self.llm and self.llm.configured),
                "lastPollAt": self.last_poll, "activeRuns": self.active_runs, "lastError": self.last_error[:300]}
        try:
            self.scoutro.call("POST", "/heartbeat", body=body)
        except RemoteError as e:
            log("heartbeat_failed", error=str(e))

    def poll_once(self):
        """Fetch and work on all runs that are waiting; returns the number of runs handled."""
        handled = 0
        try:
            self.capabilities()
            runs = self.clustro.runs("created")
            # runs this worker had started before a restart stay "active" in Clustro
            for run in self.clustro.runs("active"):
                entry = self.journal.get(run.get("id", ""))
                if entry and entry.get("state") == "started":
                    runs.append(run)
            self.last_poll = int(self.now() * 1000)
            self.last_error = ""
        except RemoteError as e:
            self.last_error = str(e)
            log("poll_failed", error=str(e))
            self.heartbeat("error")
            return 0
        for run in runs:
            if self.handle(run):
                handled += 1
        self.heartbeat("idle")
        return handled

    def handle(self, run):
        run_id = run.get("id", "")
        if not run_id:
            return False
        entry = self.journal.get(run_id) or {}
        if entry.get("state") in ("done", "failed", "skipped"):
            return False  # already reported; a repeated listing is not new work
        attempts = entry.get("attempts", 0) + 1
        if attempts > MAX_ATTEMPTS:
            self._fail(run_id, "the Scoutro research worker restarted %d times while working on this run" % (attempts - 1))
            return True
        self.journal.put(run_id, state="started", attempts=attempts, startedAt=entry.get("startedAt", int(self.now())))
        self.active_runs += 1
        self.heartbeat("working")
        try:
            try:
                self.clustro.webhook("run_started", run_id)
            except (RemoteError, urllib.error.URLError, OSError) as e:
                log("run_started_not_reported", runId=run_id, error=str(e))
            task = parse_task(run.get("input", ""))
            deadline = self.now() + int(self.limits().get("maxTaskSeconds", 300))
            result = self.execute(task, run_id, deadline)
            output = fit(result, RESULT_BUDGET)
            errors = sc.validate(json.loads(output), load_schema("result.schema.json"))
            if errors:
                raise TaskError("internal error: result violates the result schema: " + errors[0])
            if self.clustro.run_status(run_id) == "cancelled":
                raise Cancelled()
            self.clustro.complete(run_id, output)
            self.journal.put(run_id, state="done")
            log("run_completed", runId=run_id, type=task["type"], status=result["status"])
        except Cancelled:
            self.journal.put(run_id, state="skipped")
            log("run_cancelled", runId=run_id)
        except TaskError as e:
            self._fail(run_id, str(e))
        except RemoteError as e:
            if e.service == "clustro":
                # leave the run "started": it is retried after the next poll or restart
                self.last_error = str(e)
                log("clustro_error", runId=run_id, error=str(e))
            else:
                self._fail(run_id, scoutro_message(e))
        finally:
            self.active_runs -= 1
        return True

    def _fail(self, run_id, message):
        try:
            self.clustro.fail(run_id, message)
            self.journal.put(run_id, state="failed", error=message[:300])
            log("run_failed", runId=run_id, error=message)
        except RemoteError as e:
            self.last_error = str(e)
            log("clustro_error", runId=run_id, error=str(e))

    def check_cancel(self, run_id):
        if self.clustro.run_status(run_id) == "cancelled":
            raise Cancelled()

    # --- execution ----------------------------------------------------------

    def execute(self, task, run_id, deadline):
        t = task["type"]
        if t == "research":
            return self.research(task)
        if t == "portal_evaluation":
            return self.portal_evaluation(task)
        return self.crawl(task, run_id, deadline)

    def _collections(self, requested):
        """Collections to search, each inside the worker's scope (Scoutro checks again)."""
        scope, all_collections = self.scope()
        if requested:
            outside = [c for c in requested if not all_collections and c not in scope]
            if outside:
                raise TaskError("collection(s) outside the worker's data scope: " + ", ".join(outside))
            return list(requested)
        return [None] if all_collections else list(scope)

    def sources_for(self, query, collections, limit, max_chars):
        if not self.granted("search"):
            raise TaskError("the worker has no grant for 'search'")
        hits, seen = [], set()
        for col in collections:
            _, res = self.scoutro.call("GET", "/search", {"q": query, "limit": limit, "collection": col})
            for r in res.get("results", []):
                if r.get("url") and r["url"] not in seen:
                    seen.add(r["url"])
                    hits.append((r, col))
        hits = hits[:limit]
        excerpts = {}
        if self.granted("index.evidence"):
            domains = []
            for r, col in hits:
                host = (urllib.parse.urlsplit(r["url"]).hostname or "").lower()
                if host and (host, col) not in domains and re.match(r"^[a-z0-9.-]+\.[a-z][a-z0-9-]*$", host):
                    domains.append((host, col))
            for host, col in domains[:5]:
                try:
                    _, ev = self.scoutro.call("GET", "/index/evidence", {"domain": host, "collection": col,
                                                                         "limit": 8, "maxChars": max_chars})
                except RemoteError as e:
                    if e.service == "scoutro" and e.status in (400, 403):
                        continue
                    raise
                for d in ev.get("documents", []):
                    excerpts.setdefault(d.get("url", ""), d.get("excerpt", ""))
        sources = []
        for i, (r, col) in enumerate(hits, 1):
            src = {"id": i, "url": r["url"][:2048], "title": sc.sanitize(r.get("title", ""), 300),
                   "excerpt": sc.sanitize(excerpts.get(r["url"]) or r.get("snippet", ""), max_chars)}
            if col:
                src["collection"] = col
            sources.append(src)
        return sources

    def research(self, task):
        query = task["query"]
        limit = task.get("limit", 8)
        max_chars = task.get("maxChars", 1200)
        sources = self.sources_for(query, self._collections(task.get("collections")), limit, max_chars)
        result = {"scoutro_result": "1", "type": "research", "query": query, "sources": sources,
                  "warnings": [], "truncated": False}
        if not sources:
            result.update(status="no_evidence", summaryStatus="no_evidence")
            return result
        if sc.injection_suspected([{"snippet": s["excerpt"], "title": s["title"]} for s in sources]):
            result["warnings"].append("some sources contain text that looks like instructions; it was treated as data")
        result["status"] = "ok"
        if not task.get("summarize", True):
            result["summaryStatus"] = "not_requested"
        elif not self.limits().get("modelAllowed"):
            result["summaryStatus"] = "model_not_allowed"
        elif self.llm is None or not self.llm.configured:
            result["summaryStatus"] = "model_not_configured"
        else:
            try:
                statements, dropped = summarize(self.llm, query, sources)
                result["summary"] = " ".join("%s [%s]" % (st["text"].strip(), ", ".join(str(i) for i in st["sources"]))
                                             for st in statements)
                result["summaryStatus"] = "generated"
                if dropped:
                    result["warnings"].append("%d model statement(s) without valid source references were dropped" % dropped)
            except sc.LlmError as e:
                result["summaryStatus"] = "invalid_model_output" if e.kind == "invalid_model_output" else "model_error"
                result["status"] = "partial"
                result["warnings"].append("summary not available: " + str(e))
        return result

    def _discovery_module(self):
        if self._discovery is None:
            self._discovery = load_discovery()
        return self._discovery

    def portal_evaluation(self, task):
        rules = sc.load_profile_rules(self.profiles_path)
        profile = task["profile"]
        if profile not in rules["profiles"]:
            raise TaskError("unknown discovery profile '%s'" % profile)
        prules = rules["profiles"][profile]
        scope, all_collections = self.scope()
        profile_cols = [prules["collection"]] + list(prules.get("legacy_collections", []))
        allowed = [c for c in profile_cols if all_collections or c in scope]
        if not allowed:
            raise TaskError("the collections of profile '%s' (%s) are outside the worker's data scope"
                            % (profile, ", ".join(profile_cols)))
        disc = self._discovery_module()
        limit = task.get("limit", 20)
        result = {"scoutro_result": "1", "type": "portal_evaluation", "profile": profile, "warnings": [],
                  "truncated": False, "sources": [], "classifications": []}
        if "query" in task:
            result["query"] = task["query"]
            sources = self.sources_for(task["query"], allowed, min(20, limit * 2), 600)
            result["sources"] = sources
            domains = []
            for s in sources:
                d = disc.registrable_domain(urllib.parse.urlsplit(s["url"]).hostname or "")
                if d and d not in domains:
                    domains.append(d)
        else:
            domains = list(task["domains"])
        domains = domains[:limit]
        state = None
        if os.path.isfile(os.path.join(self.discovery_dir, "state.json")):
            state = disc.State(self.discovery_dir)
        else:
            result["warnings"].append("no discovery state available; stored classifications are empty")
        mode = task.get("mode", "stored")
        classify = mode == "classify"
        if classify and not self.model_usable():
            result["warnings"].append("classification needs the language model: "
                                      + ("not allowed for this worker" if not self.limits().get("modelAllowed")
                                         else "not configured (SCOUTRO_LLM_BASE_URL/SCOUTRO_LLM_MODEL)"))
            classify = False
            result["status"] = "model_unavailable"
        classifier = sc.Classifier(rules, backend="llm", llm=self.llm) if classify else None
        invalid = 0
        verdicts = set(task.get("verdicts", []))
        for d in domains:
            entry = None
            if classifier is not None:
                docs = self._evidence_docs(d, allowed)
                if not docs:
                    # no evidence: never guess; same reason code as the classifier uses for text-less pages
                    rec = sc.make_record(profile, prules["collection"], d, "UNSURE", 0.0, "unknown",
                                         sc.default_country(d), "",
                                         [sc._reason("no_indexed_text", "no indexed text in the granted collections")],
                                         [], "llm", self.llm.model, rules.get("criteria_version", "unversioned"))
                else:
                    rec = classifier.classify(profile, d, docs)
                if rec["classifier"].get("error") == "invalid_model_output":
                    invalid += 1
                entry = {"domain": d, "verdict": rec["verdict"], "source": "classified", "record": rec}
            else:
                rec = disc._stored(state, profile, d) if state is not None else None
                entry = ({"domain": d, "verdict": rec["verdict"], "source": "stored", "record": rec} if rec
                         else {"domain": d, "verdict": "UNCLASSIFIED", "source": "none"})
            if not verdicts or entry["verdict"] in verdicts:
                result["classifications"].append(entry)
        if "status" not in result:
            if invalid:
                result["status"] = "invalid_model_output" if invalid == len(domains) else "partial"
                result["warnings"].append("%d classification(s) had no valid model output and are UNSURE" % invalid)
            elif not domains:
                result["status"] = "no_evidence"
            else:
                result["status"] = "ok"
        return result

    def _evidence_docs(self, domain, collections):
        docs = []
        for col in collections:
            try:
                _, ev = self.scoutro.call("GET", "/index/evidence", {"domain": domain, "collection": col,
                                                                     "limit": 8, "maxChars": 1500})
            except RemoteError as e:
                if e.service == "scoutro" and e.status in (400, 403):
                    continue
                raise
            for d in ev.get("documents", []):
                docs.append({"url": d.get("url", ""), "title": d.get("title", ""), "snippet": d.get("excerpt", "")})
        return docs[:8]

    def crawl(self, task, run_id, deadline):
        if not self.granted("crawl.start"):
            raise TaskError("the worker has no grant for 'crawl.start'")
        body = {"url": task["url"], "collection": task["collection"]}
        for k in ("depth", "maxPages"):
            if k in task:
                body[k] = task[k]
        # the run id is the idempotency key: a restart never starts a second crawl
        _, crawl = self.scoutro.call("POST", "/crawls", body=body, headers={"Idempotency-Key": "clustro-" + run_id})
        crawl_id = crawl.get("id", "")
        replay = bool(crawl.get("idempotentReplay"))
        self.journal.put(run_id, crawlId=crawl_id)
        wait_until = min(deadline, self.now() + task.get("waitSeconds", 10 ** 9))
        state = crawl.get("state", "")

        def stop_if_cancelled():
            try:
                self.check_cancel(run_id)
            except Cancelled:
                if state in ("running", "paused") and self.granted("crawl.stop"):
                    try:
                        self.scoutro.call("POST", "/crawls/" + urllib.parse.quote(crawl_id, safe="") + "/stop", body={})
                        log("crawl_stopped", runId=run_id, crawlId=crawl_id)
                    except RemoteError as e:
                        log("crawl_stop_failed", runId=run_id, error=str(e))
                raise

        while state in ("running", "paused") and self.now() < wait_until:
            stop_if_cancelled()
            time.sleep(min(5, max(1, wait_until - self.now())))
            if not self.granted("crawl.status"):
                break
            _, crawl = self.scoutro.call("GET", "/crawls/" + urllib.parse.quote(crawl_id, safe=""))
            state = crawl.get("state", "")
        stop_if_cancelled()
        if replay:
            crawl["idempotentReplay"] = True
        result = {"scoutro_result": "1", "type": "crawl", "status": "ok", "warnings": [], "truncated": False,
                  "crawl": {k: crawl.get(k) for k in ("id", "state", "host", "collection", "depth", "maxPages",
                                                     "pagesLoaded", "idempotentReplay") if k in crawl}}
        if state in ("running", "paused"):
            result["status"] = "partial"
            result["warnings"].append("the crawl is still running; its status is reported as of now")
        if self.granted("index.evidence") and crawl.get("host"):
            try:
                _, ev = self.scoutro.call("GET", "/index/evidence", {"domain": crawl["host"].split(":")[0],
                                                                     "collection": task["collection"], "limit": 1,
                                                                     "maxChars": 100})
                result["crawl"]["indexedDocuments"] = ev.get("total", 0)
            except RemoteError:
                pass
        return result


def scoutro_message(e):
    known = {
        "collection_not_in_scope": "Scoutro refused: the collection is outside the worker's data scope.",
        "action_not_granted": "Scoutro refused: the worker is not allowed to do this (" + e.message + ").",
        "agent_paused": "The Scoutro research worker is paused by the administrator.",
        "agent_revoked": "The Scoutro research worker has been revoked.",
        "unreachable": "Scoutro is not reachable.",
    }
    if e.code.startswith("limit_exceeded"):
        return "Scoutro refused: limit exceeded (" + e.message + ")."
    return known.get(e.code, "Scoutro answered %s %s: %s" % (e.status, e.code, e.message))


def fit(result, budget):
    """Serialize within the output budget; shorten excerpts, then drop sources, and mark it."""
    text = json.dumps(result, ensure_ascii=False)
    if len(text) <= budget:
        return text
    result = json.loads(text)
    result["truncated"] = True
    for limit in (600, 300, 120, 0):
        for s in result.get("sources", []):
            s["excerpt"] = s["excerpt"][:limit]
        for c in result.get("classifications", []):
            rec = c.get("record")
            if isinstance(rec, dict) and limit < 300:
                c.pop("record", None)
        text = json.dumps(result, ensure_ascii=False)
        if len(text) <= budget:
            return text
    while result.get("sources") and len(text) > budget:
        result["sources"].pop()
        text = json.dumps(result, ensure_ascii=False)
    while result.get("classifications") and len(text) > budget:
        result["classifications"].pop()
        text = json.dumps(result, ensure_ascii=False)
    if len(text) > budget and "summary" in result:
        result["summary"] = result["summary"][:max(0, budget - (len(text) - len(result["summary"])) - 10)]
        text = json.dumps(result, ensure_ascii=False)
    return text


